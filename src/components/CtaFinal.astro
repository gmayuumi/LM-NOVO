---
import IconeWhats from './IconeWhats.astro';
import Textura from './Textura.astro';
import { whats } from '../data/site';
// Chamada final: painel azul com o teto hexagonal ao fundo e o botão do WhatsApp.
interface Props {
  titulo: string;
  texto: string;
  botao: string;
  mensagem: string;
  pilula?: string; // selo acima do título, com o ponto verde de "online"
  nota?: string;
  cta2?: { rotulo: string; href: string };
}
const { titulo, texto, botao, mensagem, pilula, nota, cta2 } = Astro.props;
---

<section class="cta" aria-labelledby="cta-titulo">
  <div class="recipiente">
    <div class="cta__painel" data-revelar>
      <Textura tipo="hex" onde="direita" />
      {pilula && <p class="pilula"><span class="ponto-vivo ponto-vivo--verde"></span> {pilula}</p>}
      <h2 id="cta-titulo">{titulo}</h2>
      <p class="cta__texto">{texto}</p>
      <div class="cta__acoes">
        <a class="btn btn--whats" href={whats(mensagem)} target="_blank" rel="noopener" data-cta-principal><IconeWhats /> {botao}</a>
        {cta2 && <a class="btn btn--vidro" href={cta2.href}>{cta2.rotulo}</a>}
      </div>
      {nota && <p class="cta__nota">{nota}</p>}
    </div>
  </div>
</section>

<style>
  .cta { position: relative; padding-block: var(--secao); }
  .cta__painel {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    overflow: hidden;
    padding: 2.5rem 1.5rem;
    border-radius: 32px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background:
      radial-gradient(70% 90% at 100% 0%, rgba(143, 220, 255, 0.55), transparent 60%),
      linear-gradient(140deg, #2e8fd6 0%, #185a93 55%, #0c2c4c 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 40px 80px -40px rgba(46, 143, 214, 0.9);
  }
  .cta__painel h2 { font-size: clamp(2.75rem, 1.6rem + 5vw, 6rem); max-width: 14ch; }
  .cta__texto { font-family: var(--f-apoio); font-size: var(--t-lead); line-height: 1.35; color: rgba(255, 255, 255, 0.9); max-width: 40ch; }
  .cta__acoes { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.4rem; }
  .cta__nota { font-family: var(--f-apoio); font-size: var(--t-pequeno); color: rgba(255, 255, 255, 0.8); }
  .cta__painel :global(.textura--hex path) { stroke: rgba(255, 255, 255, 0.24); }
  @media (min-width: 60rem) {
    .cta__painel { padding: 4rem; }
    .cta__painel h2 { max-width: 20ch; }
  }
</style>
