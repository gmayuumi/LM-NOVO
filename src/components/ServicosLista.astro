---
// Serviços como lista tipográfica: nome grande, uma linha de apoio e seta.
// No computador, a foto do serviço aparece ao passar o mouse (ou focar).
const img = (nome: string) => `/assets/img/${nome}`;
const itens = [
  { nome: 'Martelinho de ouro', apoio: 'O amassado sai, a pintura original fica', href: '/martelinho', foto: 'martelinho-tecnico-464.webp', w: 464, h: 580 },
  { nome: 'Funilaria', apoio: 'Para danos maiores, com as linhas originais', href: '/servicos#funilaria', foto: 'funilaria-yaris-traseira-720.webp', w: 720, h: 405 },
  { nome: 'Pintura', apoio: 'Cabine com estufa no Brooklin', href: '/servicos#pintura', foto: 'cabine-yaris-ampla-720.webp', w: 720, h: 405 },
  { nome: 'Estética', apoio: 'Polimento, vitrificação e higienização', href: '/servicos#estetica', foto: 'estetica-interior-porsche-720.webp', w: 720, h: 540 },
];
---

<section class="lista" aria-labelledby="lista-titulo">
  <div class="recipiente">
    <h2 id="lista-titulo" class="lista__titulo" data-titulo><span class="cromado">Serviços</span></h2>
    <ul role="list" class="lista__itens">
      {itens.map((s) => (
        <li>
          <a class="lista__link" href={s.href}>
            <img src={img(s.foto)} width={s.w} height={s.h} alt="" loading="lazy" decoding="async" />
            <span class="lista__nome">{s.nome}</span>
            <span class="lista__apoio">{s.apoio}</span>
            <span class="lista__seta" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .lista { padding-block: var(--secao); }
  .lista__titulo { font-size: var(--t-h3); margin-bottom: 2rem; }
  .lista__itens { border-top: 1px solid var(--linha); }
  .lista__itens li { border-bottom: 1px solid var(--linha); }
  .lista__link {
    position: relative;
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    grid-template-areas: 'foto nome seta' 'foto apoio seta';
    align-items: center;
    column-gap: 1rem;
    padding-block: 1.25rem;
    text-decoration: none;
  }
  .lista__link img { grid-area: foto; width: 4rem; height: 4rem; object-fit: cover; border-radius: 2px; }
  .lista__nome { grid-area: nome; font-family: var(--f-titulo); font-size: clamp(2rem, 1.4rem + 3.4vw, 5rem); line-height: 1; }
  .lista__apoio { grid-area: apoio; font-family: var(--f-apoio); color: var(--texto-2); }
  .lista__seta { grid-area: seta; font-size: 1.5rem; transition: transform 0.3s var(--curva); }
  .lista__link:hover .lista__seta,
  .lista__link:focus-visible .lista__seta { transform: translateX(6px); }

  /* computador: sem miniatura fixa; a foto aparece à direita no hover */
  @media (min-width: 60rem) and (hover: hover) {
    .lista__link {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem) auto;
      grid-template-areas: 'nome apoio seta';
      column-gap: 3rem;
      padding-block: 1.75rem;
    }
    .lista__link img {
      position: absolute;
      right: 26rem;
      top: 50%;
      width: 15rem;
      height: 10rem;
      opacity: 0;
      transform: translateY(-50%) scale(0.92);
      transition: opacity 0.3s, transform 0.4s var(--curva);
      pointer-events: none;
      z-index: 1;
    }
    .lista__link:hover img,
    .lista__link:focus-visible img { opacity: 1; transform: translateY(-50%) scale(1); }
    .lista__nome { transition: color 0.3s; }
    .lista__itens:hover .lista__link:not(:hover) .lista__nome { color: rgba(242, 245, 248, 0.35); }
  }
</style>
