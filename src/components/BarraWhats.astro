---
import IconeWhats from './IconeWhats.astro';
import { whats, MSG } from '../data/site';
interface Props { mensagem?: string; rotulo?: string }
const { mensagem = MSG.geral, rotulo = 'Pedir orçamento no WhatsApp' } = Astro.props;
---

<!-- Fixa só no celular. O body reserva o espaço para não cobrir conteúdo. -->
<div class="barra-whats" data-barra-whats>
  <a class="botao" href={whats(mensagem)} target="_blank" rel="noopener">
    <IconeWhats /> {rotulo}
  </a>
</div>

<style>
  .barra-whats {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    padding: 0.625rem var(--gutter) calc(0.625rem + env(safe-area-inset-bottom));
    background: rgba(6, 11, 18, 0.78);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    border-top: 1px solid var(--linha);
    transition: transform 0.3s var(--curva), visibility 0.3s;
  }
  .barra-whats .botao { width: 100%; }
  .barra-whats[data-oculta] { transform: translateY(110%); visibility: hidden; }

  :global(body) { padding-bottom: calc(4.5rem + env(safe-area-inset-bottom)); }

  @media (min-width: 60rem) {
    .barra-whats { display: none; }
    :global(body) { padding-bottom: 0; }
  }
</style>
