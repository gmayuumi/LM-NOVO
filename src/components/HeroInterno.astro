---
import IconeWhats from './IconeWhats.astro';
// Topo das páginas internas, no mesmo visual da home.
// Celular: foto em faixa alta no topo e o texto entrando por cima da borda dela.
// Desktop: texto à esquerda e a foto num painel de vidro à direita, com uma
// cópia minúscula e desfocada da foto enchendo o fundo de cor.
interface Botao { rotulo: string; href: string; whats?: boolean }
interface Props {
  titulo: string[]; // uma linha por item; a última ganha a cor de destaque
  subtitulo?: string; // vira a pílula acima do título
  texto: string;
  cta: Botao;
  cta2?: Botao;
  prova?: string;
  foto: { src: string; srcset?: string; alt: string; largura: number; altura: number; ambiente: string; posicao?: string };
}
const { titulo, subtitulo, texto, cta, cta2, prova, foto } = Astro.props;
const razao = (foto.largura / foto.altura).toFixed(4);
const longo = titulo.length >= 4; // título de 4 linhas: letra menor para o botão caber na 1ª tela
const externo = (b: Botao) => (b.whats || b.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
---

<section class="hero-int" aria-labelledby="hero-titulo" style={`--razao: ${razao}`}>
  <img class="hero-int__ambiente" src={`/assets/img/${foto.ambiente}`} alt="" aria-hidden="true" width="96" height="128" />
  <div class="hero-int__vitrine">
    <img
      src={foto.src}
      srcset={foto.srcset}
      sizes="(min-width: 60rem) 30rem, 100vw"
      width={foto.largura}
      height={foto.altura}
      alt={foto.alt}
      fetchpriority="high"
      style={foto.posicao ? `object-position: ${foto.posicao}` : undefined}
    />
  </div>

  <div class="recipiente hero-int__conteudo" data-revelar>
    {subtitulo && <p class="pilula hero-int__pilula"><span class="ponto-vivo"></span> {subtitulo}</p>}
    <h1 id="hero-titulo" class:list={['hero-int__titulo', { 'hero-int__titulo--longo': longo }]}>
      {titulo.map((linha, i) => <span class:list={{ 'destaque-cor': i === titulo.length - 1 }}>{linha}</span>)}
    </h1>
    <p class="hero-int__lead">{texto}</p>
    <div class="hero-int__acoes">
      <a class="btn btn--primario" data-cta-principal href={cta.href} {...externo(cta)}>{cta.whats && <IconeWhats />} {cta.rotulo}</a>
      {cta2 && <a class="btn btn--vidro" href={cta2.href} {...externo(cta2)}>{cta2.whats && <IconeWhats />} {cta2.rotulo}</a>}
    </div>
    {prova && <p class="pequeno hero-int__prova">{prova}</p>}
  </div>
</section>

<style>
  .hero-int {
    position: relative;
    isolation: isolate;
    padding-bottom: 2.5rem;
    overflow: hidden;
  }
  .hero-int__ambiente { display: none; }
  .hero-int__vitrine {
    position: relative;
    z-index: -1;
    height: max(24rem, 58svh);
    overflow: hidden;
  }
  .hero-int__vitrine img { width: 100%; height: 100%; object-fit: cover; }
  .hero-int__vitrine::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(6, 17, 32, 0.7) 0%, rgba(6, 17, 32, 0) 22%),
      linear-gradient(to top, var(--noite) 0%, rgba(6, 17, 32, 0.75) 24%, rgba(6, 17, 32, 0) 55%),
      radial-gradient(90% 50% at 0% 100%, rgba(46, 143, 214, 0.35), transparent 70%);
  }
  .hero-int__conteudo { position: relative; display: grid; gap: 1.1rem; justify-items: start; margin-top: -7rem; }

  .hero-int__titulo { font-size: clamp(3.25rem, 1.4rem + 6.4vw, 7rem); line-height: 0.92; }
  .hero-int__titulo--longo { font-size: clamp(3rem, 1.6rem + 4.6vw, 5.75rem); }
  .hero-int__titulo > span { display: block; }
  .hero-int__lead { font-family: var(--f-apoio); font-size: var(--t-lead); line-height: 1.35; color: rgba(242, 245, 248, 0.88); max-width: 38ch; }
  .hero-int__acoes { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.4rem; }

  @media (min-width: 60rem) {
    .hero-int {
      /* largura da foto: pela altura da tela, sem passar de 36% da largura */
      --midia-l: min(calc(min(100svh - var(--altura-topo) - 14vh, 44rem) * var(--razao)), 36vw);
      display: grid;
      align-items: center;
      min-height: min(100svh, 60rem);
      padding-block: calc(var(--altura-topo) + 3rem) 3rem;
    }
    .hero-int__ambiente {
      display: block;
      position: absolute;
      inset: -12%;
      z-index: -2;
      width: 124%;
      max-width: none;
      height: 124%;
      object-fit: cover;
      opacity: 0.8; /* o desfoque já vem na imagem */
    }
    .hero-int::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -2;
      background:
        linear-gradient(90deg, rgba(6, 17, 32, 0.95) 0%, rgba(6, 17, 32, 0.62) 48%, rgba(6, 17, 32, 0.3) 100%),
        radial-gradient(60% 70% at 0% 100%, rgba(46, 143, 214, 0.35), transparent 70%);
    }
    /* a foto num painel de vidro, centralizado na vertical */
    .hero-int__vitrine {
      position: absolute;
      overflow: visible;
      inset: var(--altura-topo) auto 0 auto;
      right: max(var(--gutter), calc((100vw - var(--largura)) / 2));
      width: var(--midia-l);
      height: calc(var(--midia-l) / var(--razao));
      margin-block: auto;
      z-index: 0;
      padding: 0.6rem;
      border-radius: 28px;
      border: 1px solid rgba(143, 212, 239, 0.3);
      background: linear-gradient(135deg, rgba(92, 200, 240, 0.16), rgba(35, 120, 179, 0.06));
      box-shadow: inset 0 1px 0 rgba(190, 232, 255, 0.3), 0 40px 100px -30px rgba(0, 0, 0, 0.8), 0 0 80px -20px rgba(46, 143, 214, 0.6);
      box-sizing: content-box;
    }
    .hero-int__vitrine::after { content: none; }
    .hero-int__vitrine img { border-radius: 20px; }
    .hero-int__conteudo { margin-top: 0; padding-right: calc(var(--midia-l) + 5rem); }
  }
</style>
