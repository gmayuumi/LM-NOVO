---
// Passos do martelinho em cartões com foto real do reparo. No celular, os
// cartões deslizam para o lado; no computador, ficam lado a lado.
// Nada prende a tela na rolagem.
interface Passo { titulo: string; texto: string; foto: string; alt: string }
interface Props {
  id: string;
  titulo: string;
  destaque?: string;
  lead?: string;
  passos: Passo[];
}
const { id, titulo, destaque, lead, passos } = Astro.props;
const img = (nome: string) => `/assets/img/${nome}`;
---

<section class="processo" id={id} aria-labelledby={`${id}-titulo`}>
  <div class="recipiente">
    <div class="sec-cabeca" data-revelar>
      <h2 id={`${id}-titulo`}>{titulo}{destaque && <> <span class="destaque-cor">{destaque}</span></>}</h2>
      {lead && <p class="lead">{lead}</p>}
    </div>
    <ol role="list" class="processo__passos" tabindex="0" aria-label="Passos do reparo">
      {passos.map((p, i) => (
        <li class="passo" data-revelar style={`--atraso: ${i * 0.08}s`}>
          <img src={img(`${p.foto}-464.webp`)} width="464" height="832" alt={p.alt} loading="lazy" decoding="async" />
          <div class="passo__texto vidro">
            <p class="pilula passo__num">Passo {i + 1}</p>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <slot />
</section>

<style>
  .processo { padding-top: var(--secao); }
  .processo__passos {
    display: flex;
    gap: 1rem;
    margin-inline: calc(var(--gutter) * -1);
    padding: 0.25rem var(--gutter) 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .processo__passos::-webkit-scrollbar { display: none; }
  .passo {
    position: relative;
    isolation: isolate;
    flex: 0 0 min(80vw, 20rem);
    scroll-snap-align: start;
    display: grid;
    align-items: end;
    min-height: 30rem;
    overflow: hidden;
    border-radius: var(--raio);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .passo img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .passo::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgba(6, 17, 32, 0.8), rgba(6, 17, 32, 0) 65%); }
  .passo__texto { display: grid; gap: 0.5rem; justify-items: start; margin: 0.6rem; padding: 1.1rem; --raio: 16px; }
  .passo__num { padding: 0.3rem 0.75rem; font-size: 0.8125rem; }
  .passo__texto h3 { font-size: clamp(1.75rem, 1.5rem + 1vw, 2.25rem); }
  .passo__texto p:not(.pilula) { color: rgba(242, 245, 248, 0.86); font-size: 0.9375rem; line-height: 1.5; }

  .processo :global(.processo__fechamento) {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-top: 2rem;
  }

  @media (min-width: 64rem) {
    .processo__passos { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-inline: 0; padding-inline: 0; overflow: visible; }
    .passo { min-height: 36rem; }
    .processo :global(.processo__fechamento) { grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
  }
</style>
