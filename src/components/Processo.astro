---
// Passos do martelinho com a tela parada: a barra de luz troca a foto a cada passo.
// Sem animação (reduced-motion ou sem JS), vira uma lista simples de foto + texto.
// A animação fica em src/scripts/site.ts ([data-processo-palco]).
interface Passo { titulo: string; texto: string; foto: string; alt: string }
interface Props {
  id: string;
  titulo: string;
  lead?: string;
  passos: Passo[];
}
const { id, titulo, lead, passos } = Astro.props;
const img = (nome: string) => `/assets/img/${nome}`;
const compacto = passos.length > 3;
---

<section class:list={['processo', { 'processo--compacto': compacto }]} id={id} aria-labelledby={`${id}-titulo`}>
  <div class="recipiente processo__intro">
    <h2 id={`${id}-titulo`} data-titulo><span class="cromado" data-brilho>{titulo}</span></h2>
    {lead && <p class="lead">{lead}</p>}
  </div>

  <div class="processo__palco" data-processo-palco>
    <div class="processo__ambiente" aria-hidden="true">
      {passos.map((p) => <img src={img(`${p.foto}-ambiente.webp`)} alt="" width="96" height="172" loading="lazy" decoding="async" />)}
    </div>
    <div class="recipiente processo__grade">
      <div class="processo__contador" aria-hidden="true">{passos.map(() => <span></span>)}</div>
      <ol role="list" class="processo__passos">
        {passos.map((p, i) => (
          <li class="passo" style={`--z: ${i + 1}`}>
            <figure class="passo__figura">
              <img src={img(`${p.foto}-464.webp`)} width="464" height="832" alt={p.alt} loading="lazy" decoding="async" />
            </figure>
            <div class="passo__texto">
              <span class="passo__num">{String(i + 1).padStart(2, '0')}</span>
              <h3><span class="cromado">{p.titulo}</span></h3>
              <p>{p.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <slot />
</section>

<style>
  /* =================================================================
     PROCESSO: passos do martelinho com a tela parada
     ================================================================= */
  .processo { padding-top: var(--secao); }
  .processo__intro { display: grid; gap: 1.25rem; margin-bottom: 3rem; }
  .processo__ambiente,
  .processo__contador { display: none; }

  /* sem animação: lista simples, foto e texto de cada passo */
  .processo__passos { display: grid; gap: 3rem; }
  .passo { display: grid; gap: 1.25rem; }
  .passo__figura { position: relative; margin: 0; max-width: 22rem; }
  .passo__figura img { width: 100%; border-radius: 10px; border: 1px solid var(--linha); }
  .passo__texto { display: grid; gap: 0.5rem; max-width: 30rem; }
  .passo__num {
    font-family: var(--f-titulo);
    font-size: 1.25rem;
    letter-spacing: 0.08em;
    color: var(--azul-led);
    text-shadow: 0 0 12px rgba(77, 181, 220, 0.8);
  }
  .passo__texto h3 { font-size: clamp(2.5rem, 1.8rem + 3vw, 4.5rem); }
  .passo__texto p { color: var(--texto-2); font-size: 1.0625rem; }

  .processo :global(.processo__fechamento) {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-block: 4rem var(--secao);
  }

  @media (min-width: 60rem) {
    .passo { grid-template-columns: minmax(0, 1fr) minmax(0, 22rem); align-items: center; gap: 4rem; }
    .passo__figura { order: 2; }
    .processo :global(.processo__fechamento) { grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
  }

  /* com animação: a tela fica parada e os passos trocam com a luz */
  :global(.mov) .processo__palco {
    position: relative;
    isolation: isolate;
    height: 100svh;
    overflow: hidden;
  }
  :global(.mov) .passo__figura {
    --corte: 0%;
    --luz: 0;
    clip-path: inset(0 0 0 var(--corte));
  }
  :global(.mov) .passo:not(:first-child) .passo__figura { --corte: 100%; }
  :global(.mov) .passo__figura::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--corte) - 1px);
    width: 3px;
    background: #fff;
    box-shadow: 0 0 10px 2px rgba(255, 255, 255, 0.95), 0 0 34px 8px rgba(77, 181, 220, 0.8);
    opacity: var(--luz);
  }
  :global(.mov) .passo__figura { z-index: var(--z); }
  :global(.mov) .processo__contador {
    display: flex;
    gap: 0.375rem;
    z-index: 6;
  }
  :global(.mov) .processo__contador span {
    position: relative;
    width: 2.25rem;
    height: 3px;
    overflow: hidden;
    background: rgba(242, 245, 248, 0.2);
  }
  :global(.mov) .processo__contador span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--azul-led);
    box-shadow: 0 0 8px var(--azul-led);
    transform: scaleX(var(--cheio, 0));
    transform-origin: 0 50%;
  }
  :global(.mov) .processo__contador span:first-child { --cheio: 1; }

  /* celular: foto em tela cheia, texto por cima */
  @media (max-width: 59.99rem) {
    :global(.mov) .processo__grade,
    :global(.mov) .processo__passos,
    :global(.mov) .passo { position: static; display: block; }
    :global(.mov) .passo__figura {
      position: absolute;
      inset: 0;
      max-width: none;
    }
    :global(.mov) .passo__figura img { width: 100%; height: 100%; object-fit: cover; border: 0; border-radius: 0; }
    :global(.mov) .passo__figura::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(5, 8, 13, 0.97) 0%, rgba(5, 8, 13, 0.7) 32%, rgba(5, 8, 13, 0) 60%);
    }
    :global(.mov) .passo__texto {
      position: absolute;
      left: var(--gutter);
      right: var(--gutter);
      bottom: calc(6rem + env(safe-area-inset-bottom));
      z-index: 5;
    }
    :global(.mov) .passo:not(:first-child) .passo__texto { opacity: 0; visibility: hidden; }
    :global(.mov) .passo__texto p { color: rgba(242, 245, 248, 0.88); }
    :global(.mov) .processo__contador {
      position: absolute;
      top: calc(var(--altura-topo) + 1rem);
      left: var(--gutter);
    }
  }

  /* desktop: textos à esquerda, "display" alto à direita, luz ambiente atrás */
  @media (min-width: 60rem) {
    :global(.mov) .processo__ambiente {
      display: block;
      position: absolute;
      inset: -10%;
      z-index: -1;
    }
    :global(.mov) .processo__ambiente img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: blur(34px) saturate(1.4) brightness(0.5);
      opacity: 0;
    }
    :global(.mov) .processo__ambiente img:first-child { opacity: 1; }
    :global(.mov) .processo__ambiente::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(5, 8, 13, 0.94) 0%, rgba(5, 8, 13, 0.6) 50%, rgba(5, 8, 13, 0.25) 100%);
    }
    :global(.mov) .processo__grade {
      position: relative;
      height: 100%;
      display: grid;
      align-content: center;
      padding-top: var(--altura-topo);
    }
    :global(.mov) .processo__passos { position: static; display: grid; gap: 2.25rem; max-width: 44%; margin-left: 2.5rem; }
    :global(.mov) .passo { display: block; }
    :global(.mov) .passo__figura {
      position: absolute;
      top: calc(50% + var(--altura-topo) / 2);
      right: 0;
      height: min(76svh, 48rem);
      aspect-ratio: 464 / 832;
      max-width: none;
      transform: translateY(-50%);
    }
    :global(.mov) .passo__figura img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 12px;
      border: 1px solid rgba(220, 236, 248, 0.38);
      box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.9), 0 0 60px -12px rgba(77, 181, 220, 0.4);
    }
    :global(.mov) .passo:not(:first-child) .passo__texto { opacity: 0.26; }
    /* 4 passos ou mais: textos menores para caber a lista inteira */
    :global(.mov) .processo--compacto .processo__passos { gap: 1.5rem; }
    :global(.mov) .processo--compacto .passo__texto h3 { font-size: clamp(2.25rem, 1rem + 2.2vw, 3.25rem); }
    :global(.mov) .processo--compacto .passo__texto p { font-size: 1rem; }
    :global(.mov) .processo__contador {
      position: absolute;
      left: 0;
      top: calc(50% + var(--altura-topo) / 2);
      flex-direction: column;
      transform: translateY(-50%);
    }
    :global(.mov) .processo__contador span { width: 3px; height: 4.5rem; }
    :global(.mov) .processo__contador span::after { transform: scaleY(var(--cheio, 0)); transform-origin: 50% 0; }
  }
</style>
