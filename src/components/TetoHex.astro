---
// Teto de LED hexagonal, igual ao da oficina (aparece nas fotos e no vídeo).
// Cada hexágono é feito de 6 tubos separados; há uma moldura retangular em volta.
// A animação (src/scripts/site.ts) acende os tubos com a piscada de lâmpada.
interface Props { class?: string }
const { class: classe } = Astro.props;

const R = 58; // raio do hexágono (centro ao vértice)
const r = R * 0.86; // raio desenhado: deixa uma fresta entre hexágonos vizinhos
const larg = Math.sqrt(3) * R;
const colunas = 11;
const linhas = 6;
const margem = 40;
const encurta = 0.09; // folga na ponta de cada tubo

type Tubo = { x1: number; y1: number; x2: number; y2: number };
const tubos: Tubo[] = [];

const ponto = (cx: number, cy: number, i: number) => {
  const a = ((60 * i - 30) * Math.PI) / 180;
  return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
};
const tubo = (x1: number, y1: number, x2: number, y2: number, k = encurta) => {
  const dx = x2 - x1;
  const dy = y2 - y1;
  tubos.push({ x1: x1 + dx * k, y1: y1 + dy * k, x2: x2 - dx * k, y2: y2 - dy * k });
};

for (let l = 0; l < linhas; l++) {
  for (let c = 0; c < colunas; c++) {
    const cx = margem + larg / 2 + c * larg + (l % 2) * (larg / 2);
    const cy = margem + R + l * 1.5 * R;
    for (let i = 0; i < 6; i++) {
      const [x1, y1] = ponto(cx, cy, i);
      const [x2, y2] = ponto(cx, cy, i + 1);
      tubo(x1, y1, x2, y2);
    }
  }
}

const W = margem * 2 + larg * colunas + larg / 2;
const H = margem * 2 + R * 2 + (linhas - 1) * 1.5 * R;

// Moldura: tubos compridos em volta da grade
const pedacos = 6;
for (let i = 0; i < pedacos; i++) {
  const a = 12 + ((W - 24) / pedacos) * i;
  const b = 12 + ((W - 24) / pedacos) * (i + 1);
  tubo(a, 12, b, 12, 0.03);
  tubo(a, H - 12, b, H - 12, 0.03);
}
for (let i = 0; i < 3; i++) {
  const a = 12 + ((H - 24) / 3) * i;
  const b = 12 + ((H - 24) / 3) * (i + 1);
  tubo(12, a, 12, b, 0.05);
  tubo(W - 12, a, W - 12, b, 0.05);
}
const f = (n: number) => n.toFixed(1);
---

<div class:list={['teto', classe]} aria-hidden="true">
  <svg class="teto__svg" viewBox={`0 0 ${f(W)} ${f(H)}`} preserveAspectRatio="xMidYMin slice" focusable="false">
    <g class="teto__tubos">
      {tubos.map((t) => <line class="tubo" x1={f(t.x1)} y1={f(t.y1)} x2={f(t.x2)} y2={f(t.y2)} />)}
    </g>
  </svg>
</div>

<style>
  .teto {
    pointer-events: none;
    perspective: 760px;
    perspective-origin: 50% -20%;
    -webkit-mask-image: linear-gradient(to bottom, #000 25%, transparent 92%);
    mask-image: linear-gradient(to bottom, #000 25%, transparent 92%);
  }
  .teto__svg {
    width: 150%;
    max-width: none;
    margin-left: -25%;
    transform: rotateX(62deg);
    transform-origin: 50% 0;
    overflow: visible;
    /* o brilho vai no <svg> (filtros CSS em elementos internos do SVG falham em alguns navegadores) */
    filter: drop-shadow(0 0 3px rgba(215, 242, 255, 0.95)) drop-shadow(0 0 12px rgba(77, 181, 220, 0.75));
  }
  .teto__tubos {
    stroke: #f4fbff;
    stroke-width: 3.2;
    stroke-linecap: round;
  }
</style>
