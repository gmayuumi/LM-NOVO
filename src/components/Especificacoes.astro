---
// Benefícios em caixas de vidro: título curto e explicação.
// A primeira caixa ganha o azul cheio da marca, como na home.
interface Item { titulo: string; texto: string }
interface Props {
  id: string;
  titulo: string;
  destaque?: string; // final do título, na cor de destaque
  lead?: string;
  itens: Item[];
}
const { id, titulo, destaque, lead, itens } = Astro.props;
---

<section class="ficha" id={id} aria-labelledby={`${id}-titulo`}>
  <div class="recipiente">
    <div class="sec-cabeca" data-revelar>
      <h2 id={`${id}-titulo`}>{titulo}{destaque && <> <span class="destaque-cor">{destaque}</span></>}</h2>
      {lead && <p class="lead">{lead}</p>}
      <slot name="cabeca" />
    </div>
    <dl class:list={['ficha__lista', { 'ficha__lista--3': itens.length === 3 }]}>
      {itens.map((item, i) => (
        <div class:list={['ficha__item', i === 0 ? 'ficha__item--destaque' : 'vidro']} data-revelar style={`--atraso: ${i * 0.06}s`}>
          <dt>{item.titulo}</dt>
          <dd>{item.texto}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .ficha { padding-top: var(--secao); }
  .ficha__lista { display: grid; gap: 0.9rem; }
  .ficha__item { display: grid; gap: 0.6rem; align-content: start; padding: 1.5rem; }
  .ficha__item dt { font-family: var(--f-titulo); font-size: clamp(2rem, 1.6rem + 1.4vw, 2.75rem); line-height: 0.95; }
  .ficha__item dd { margin: 0; color: var(--texto-2); }
  .ficha__item--destaque {
    border-radius: var(--raio);
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: linear-gradient(145deg, #3a9fe4, #1a5f9c);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 24px 48px -22px rgba(46, 143, 214, 0.8);
  }
  .ficha__item--destaque dd { color: rgba(255, 255, 255, 0.92); }

  @media (min-width: 48rem) {
    .ficha__lista { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ficha__lista--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .ficha__lista:not(.ficha__lista--3) { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .ficha__item { padding: 1.75rem; }
  }
</style>
