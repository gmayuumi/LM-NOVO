---
// Vídeo curto, sem som, que toca sozinho só quando está na tela
// (e nunca com reduced-motion ou economia de dados). Tem botão de pausa.
// Sem JavaScript, mostra os controles do navegador.
interface Props {
  src: string;
  poster: string;
  largura: number;
  altura: number;
  rotulo: string; // descreve o vídeo para leitores de tela
  class?: string;
}
const { src, poster, largura, altura, rotulo, class: classe } = Astro.props;
---

<div class:list={['loop', classe]} data-video-auto>
  <video muted playsinline loop controls preload="none" width={largura} height={altura} poster={poster} aria-label={rotulo}>
    <source src={src} type="video/mp4" />
  </video>
  <button class="loop__pausa" type="button" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" class="loop__icone-pausa"><path d="M8 5h3v14H8zM13 5h3v14h-3z" fill="currentColor" /></svg>
    <svg viewBox="0 0 24 24" aria-hidden="true" class="loop__icone-tocar"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
    <span class="visualmente-oculto" data-rotulo>Pausar vídeo</span>
  </button>
</div>

<style>
  .loop { position: relative; }
  .loop video { width: 100%; height: 100%; object-fit: cover; }
  .loop__pausa {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(214, 232, 246, 0.45);
    border-radius: 50%;
    background: rgba(5, 8, 13, 0.65);
    color: #fff;
    cursor: pointer;
  }
  .loop__pausa[hidden] { display: none; }
  .loop__pausa svg { width: 1.125rem; height: 1.125rem; }
  .loop__icone-tocar { display: none; }
  .loop__pausa[data-pausado] .loop__icone-tocar { display: block; }
  .loop__pausa[data-pausado] .loop__icone-pausa { display: none; }
</style>
