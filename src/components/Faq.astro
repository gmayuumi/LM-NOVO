---
// Perguntas frequentes com <details>: funciona sem JavaScript.
// O "+" é feito de duas barras de LED; aberta, a vertical apaga.
interface Pergunta { pergunta: string; resposta: string }
interface Props {
  titulo?: string;
  lead?: string;
  itens: Pergunta[];
}
const { titulo = 'Dúvidas frequentes', lead, itens } = Astro.props;
---

<section class="faq" aria-labelledby="faq-titulo">
  <div class="recipiente faq__grade">
    <div class="faq__cabeca">
      <h2 id="faq-titulo" data-titulo><span class="cromado" data-brilho>{titulo}</span></h2>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    <div class="faq__lista">
      {itens.map((item) => (
        <details class="faq__item">
          <summary>
            <span>{item.pergunta}</span>
            <span class="faq__icone" aria-hidden="true"></span>
          </summary>
          <p>{item.resposta}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { padding-block: var(--secao); }
  .faq__grade { display: grid; gap: 2.5rem; }
  .faq__cabeca { display: grid; gap: 1.25rem; align-content: start; justify-items: start; }
  .faq__lista { border-top: 1px solid var(--linha); }
  .faq__item { border-bottom: 1px solid var(--linha); }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 3rem;
    padding-block: 1.25rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--f-apoio);
    font-weight: 700;
    font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem);
    line-height: 1.3;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary:hover { color: var(--azul-led-claro); }
  .faq__icone {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
  }
  .faq__icone::before,
  .faq__icone::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: 2px;
    background: var(--azul-led);
    box-shadow: 0 0 8px rgba(77, 181, 220, 0.8);
    transform: translate(-50%, -50%);
    transition: transform 0.35s var(--curva), opacity 0.35s;
  }
  .faq__icone::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq__item[open] .faq__icone::after { transform: translate(-50%, -50%) rotate(0deg); opacity: 0; }
  .faq__item p {
    padding-bottom: 1.5rem;
    color: var(--texto-2);
    max-width: 62ch;
  }
  .faq__item[open] p { animation: faq-luz 0.5s var(--curva); }
  @keyframes faq-luz {
    from { opacity: 0; transform: translateY(-6px); }
  }

  @media (min-width: 64rem) {
    .faq__grade { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 5rem; }
    .faq__cabeca { position: sticky; top: calc(var(--altura-topo) + 2.5rem); }
  }
</style>
