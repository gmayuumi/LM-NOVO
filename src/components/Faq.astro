---
// Perguntas frequentes com <details>: funciona sem JavaScript.
// Cada pergunta é uma caixa de vidro; o "+" vira "−" quando abre.
interface Pergunta { pergunta: string; resposta: string }
interface Props {
  titulo?: string;
  destaque?: string;
  lead?: string;
  itens: Pergunta[];
}
const { titulo = 'Dúvidas', destaque = 'frequentes', lead, itens } = Astro.props;
---

<section class="faq" aria-labelledby="faq-titulo">
  <div class="recipiente faq__grade">
    <div class="faq__cabeca" data-revelar>
      <h2 id="faq-titulo">{titulo}{destaque && <> <span class="destaque-cor">{destaque}</span></>}</h2>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    <div class="faq__lista" data-revelar>
      {itens.map((item) => (
        <details class="faq__item vidro">
          <summary>
            <span>{item.pergunta}</span>
            <span class="faq__icone" aria-hidden="true"></span>
          </summary>
          <p>{item.resposta}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { padding-top: var(--secao); }
  .faq__grade { display: grid; gap: 2rem; }
  .faq__cabeca { display: grid; gap: 1.25rem; align-content: start; justify-items: start; }
  .faq__cabeca .lead { color: var(--texto-2); }
  .faq__lista { display: grid; gap: 0.75rem; }
  .faq__item { --raio: 18px; }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 3rem;
    padding: 1.1rem 1.25rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--f-apoio);
    font-weight: 700;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.3;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary:hover { color: #8fdcff; }
  .faq__icone {
    position: relative;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #43a8ec, #1f6fb2);
  }
  .faq__icone::before,
  .faq__icone::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.8rem;
    height: 2px;
    background: #fff;
    transform: translate(-50%, -50%);
    transition: transform 0.35s var(--curva), opacity 0.35s;
  }
  .faq__icone::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq__item[open] .faq__icone::after { transform: translate(-50%, -50%) rotate(0deg); opacity: 0; }
  .faq__item p {
    padding: 0 1.25rem 1.25rem;
    color: var(--texto-2);
    max-width: 62ch;
  }
  .faq__item[open] p { animation: faq-abre 0.4s var(--curva); }
  @keyframes faq-abre {
    from { opacity: 0; transform: translateY(-6px); }
  }

  @media (min-width: 64rem) {
    .faq__grade { grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr); gap: 4rem; }
    .faq__cabeca { position: sticky; top: calc(var(--altura-topo) + 2.5rem); }
  }
</style>
