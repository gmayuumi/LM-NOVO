---
import Comparador from './Comparador.astro';
// Antes e depois do Nissan Kicks: a tela para e a barra de luz atravessa o carro
// conforme a rolagem (src/scripts/site.ts, [data-palco]). Arrastar também funciona.
const img = (nome: string) => `/assets/img/${nome}`;
---

<!-- ANTES E DEPOIS: a luz atravessa o carro =========================== -->
<section class="ad" id="antes-e-depois" aria-labelledby="ad-titulo">
  <div class="ad__palco" data-palco style="--ad: 0.5">
    <img class="ad__ambiente" src={img('kicks-ambiente.webp')} alt="" aria-hidden="true" width="96" height="120" loading="lazy" />
    <h2 id="ad-titulo" class="ad__titulo">
      <span class="ad__antes cromado">Antes</span><span class="visualmente-oculto"> e </span><span class="ad__depois cromado">Depois</span>
    </h2>
    <div class="ad__visual">
      <Comparador
        antes={{ src: img('kicks-antes-414.webp'), alt: 'Antes: tampa traseira do Nissan Kicks com amassado; o reflexo da barra de luz aparece entortado' }}
        depois={{ src: img('kicks-depois-414.webp'), alt: 'Depois: a mesma tampa lisa, com o reflexo reto e a pintura original' }}
        largura={414}
        altura={518}
        rotulo="Comparar antes e depois do Nissan Kicks"
      />
    </div>
    <p class="pequeno ad__legenda">Mesmo carro, mesma luz: <strong>só o amassado saiu.</strong> A pintura continua a original de fábrica.</p>
  </div>
</section>
<style>
  /* =================================================================
     ANTES E DEPOIS
     ================================================================= */
  .ad__palco {
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 1.25rem;
    min-height: 100svh;
    padding: calc(var(--altura-topo) + 1rem) var(--gutter) calc(6rem + env(safe-area-inset-bottom));
    overflow: hidden;
  }
  .ad__ambiente {
    position: absolute;
    inset: -10%;
    width: 120%;
    max-width: none;
    height: 120%;
    object-fit: cover;
    z-index: -1;
    opacity: 0.68; /* o desfoque já vem na imagem */
  }
  .ad__titulo {
    display: flex;
    justify-content: space-between;
    width: 100%;
    max-width: 30rem;
    font-size: clamp(3rem, 2rem + 6vw, 5rem);
  }
  .ad__antes { opacity: calc(0.18 + 0.82 * var(--ad, 0.5)); }
  .ad__depois { opacity: calc(0.18 + 0.82 * (1 - var(--ad, 0.5))); }
  .ad__visual {
    width: 100%;
    /* altura da tela menos título, legenda e barra do WhatsApp */
    max-width: min(30rem, calc((100svh - 18.75rem - env(safe-area-inset-bottom)) * 414 / 518));
  }
  .ad__visual :global(.comparar__quadro) {
    border-radius: 12px;
    border: 1px solid rgba(220, 236, 248, 0.38);
    box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.9), 0 0 60px -12px rgba(77, 181, 220, 0.45);
  }
  .ad__legenda { text-align: center; max-width: 30rem; }
  .ad__legenda strong { color: var(--branco); }
  .ad { padding-bottom: var(--secao); }

  @media (min-width: 60rem) {
    .ad__palco { padding: calc(var(--altura-topo) + 2rem) var(--gutter) 2.5rem; }
    .ad__titulo {
      position: absolute;
      inset: 0;
      z-index: -1;
      max-width: none;
      align-items: center;
      padding: var(--altura-topo) max(var(--gutter), calc((100vw - var(--largura)) / 2)) 0;
      font-size: clamp(5rem, 1rem + 8vw, 11rem);
      pointer-events: none;
    }
    .ad__visual { max-width: min(30rem, calc((100svh - 12rem) * 414 / 518)); }
  }
</style>
