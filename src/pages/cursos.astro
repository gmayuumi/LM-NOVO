---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import BarraWhats from '../components/BarraWhats.astro';
import HeroInterno from '../components/HeroInterno.astro';
import Especificacoes from '../components/Especificacoes.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import IconeWhats from '../components/IconeWhats.astro';
import { SITE, whats } from '../data/site';

// Funil separado: alunos, não donos de carro. Mensagens do site antigo (docs/conteudo-site-atual.md, 4).
const img = (nome: string) => `/assets/img/${nome}`;
const msg = {
  consultor: 'Olá! Vim pelo site e gostaria de saber mais sobre as turmas dos cursos.',
  vaga: 'Olá! Quero investir no meu futuro. Podem me passar mais informações sobre os cursos?',
  flutuante: 'Olá! Vim pelo site e quero detalhes sobre a Formação em Estética Automotiva.',
  duvida: 'Olá! Gostei das informações mas tenho uma dúvida específica sobre os cursos.',
  disponibilidade: 'Olá! Gostaria de verificar as datas disponíveis e reservar minha vaga nos cursos de estética automotiva.',
};

const cursos = [
  {
    etiqueta: 'Alta lucratividade',
    titulo: 'Curso de Martelinho de Ouro',
    texto: 'A habilidade mais requisitada. Aprenda a ler a chapa, usar as alavancas e remover amassados preservando a pintura original. Baixo investimento em ferramentas, altíssimo valor de mão de obra.',
    mensagem: 'Olá! Quero saber a grade e datas do curso de *Martelinho de Ouro*.',
    foto: { src: img('passo-reparo-464.webp'), largura: 464, altura: 832, alt: 'Mão do técnico com a ferramenta de martelinho de ouro na lataria preta, com o reflexo da barra de luz' },
  },
  {
    etiqueta: 'Serviço recorrente',
    titulo: 'Curso de Higienização Automotiva',
    texto: 'O serviço de entrada perfeito. Domine a extração de sujeira, uso correto de químicos (pH), hidratação de couro e oxi-sanitização. Entregue um interior com aspecto, toque e cheiro de zero km.',
    mensagem: 'Olá! Quero saber a grade e datas do curso de *Higienização Automotiva*.',
    foto: { src: img('estetica-interior-porsche-720.webp'), largura: 720, altura: 540, alt: 'Bancos de couro vermelho de um Porsche depois da higienização' },
  },
  {
    etiqueta: 'Ticket alto premium',
    titulo: 'Curso de Polimento Profissional',
    texto: 'O passaporte para o Detailing. Domine o uso de politrizes (Rotativa e Roto-orbital), setup de boinas e compostos, técnica de corte, refino e lustro para um acabamento espelhado e vitrificação.',
    mensagem: 'Olá! Quero saber a grade e datas do curso de *Polimento Profissional*.',
    foto: { src: img('estetica-creta-capo-484.webp'), largura: 484, altura: 453, alt: 'Capô azul de um Hyundai Creta espelhado, refletindo as luzes de LED da oficina' },
  },
];

const motivos = [
  { titulo: 'Aulas 100% práticas', texto: 'Nada de ficar sentado olhando slide. Você vai colocar a mão na massa em carros e peças reais dentro de uma oficina que funciona todos os dias.' },
  { titulo: 'Certificado válido', texto: 'Ao final do curso, você recebe um certificado de conclusão reconhecido, gerando autoridade imediata para você apresentar aos seus futuros clientes.' },
  { titulo: 'Professores de elite', texto: 'Você não vai aprender com "teóricos", mas sim com especialistas que vivem da estética automotiva e faturam alto todos os meses no mercado de São Paulo.' },
];

const perguntas = [
  {
    pergunta: 'Preciso ter experiência prévia com carros?',
    resposta: 'Absolutamente não! Nossa metodologia foi desenhada para pegar você "do zero". Explicamos desde o nome das ferramentas até as técnicas mais avançadas, passo a passo.',
  },
  {
    pergunta: 'O curso ensina sobre como atrair clientes e cobrar?',
    resposta: 'Sim! Não adianta ter a técnica e não saber vender. Durante o curso, os professores compartilham dicas valiosas do dia a dia da oficina sobre precificação, atendimento e como gerar valor para o cliente aprovar o orçamento.',
  },
  {
    pergunta: 'Tem certificado de conclusão?',
    resposta: 'Com certeza. Ao concluir sua formação com êxito, você receberá um Certificado de Conclusão exclusivo da LM Estética Automotiva, atestando suas novas habilidades.',
  },
  {
    pergunta: 'Qual a duração e onde acontecem as aulas?',
    resposta: 'A duração varia de acordo com a modalidade escolhida (intensivo ou extensivo). Todas as aulas acontecem presencialmente na nossa sede em Santo Amaro - SP, um ambiente de oficina 100% real.',
  },
];

// Dados estruturados dos cursos (o site antigo usava "Formação Profissional em Estética Automotiva")
const jsonLdCursos = cursos.map((c) => ({
  '@type': 'Course',
  name: c.titulo,
  description: c.texto,
  url: `${SITE.url}/cursos`,
  inLanguage: 'pt-BR',
  provider: { '@type': 'Organization', name: SITE.nome, sameAs: SITE.url },
}));
---

<Base
  titulo="Cursos de martelinho de ouro, polimento e higienização em Santo Amaro, SP | LM Estética Automotiva"
  descricao="Aprenda martelinho de ouro, polimento e higienização 100% na prática. Cursos presenciais com certificado em Santo Amaro, Zona Sul de SP. Monte seu próprio negócio no mercado automotivo."
  caminho="/cursos"
  preloadImagem={img('curso-pratica-464.webp')}
  jsonLdExtra={jsonLdCursos}
>
  <Cabecalho
    atual="/cursos"
    cta={{ rotulo: 'Falar com consultor', rotuloLongo: 'Falar com consultor no WhatsApp', mensagem: msg.consultor }}
  />

  <main>
    <HeroInterno
      titulo={['Cursos de', 'estética', 'automotiva', 'na prática.']}
      subtitulo="Formação profissional em martelinho de ouro, polimento e higienização."
      texto="Fuja da teoria cansativa. Domine as técnicas mais rentáveis do mercado em um ambiente de oficina real. Faça nosso curso, seja dono do seu próprio negócio e conquiste sua liberdade financeira."
      cta={{ rotulo: 'Garantir minha vaga no WhatsApp', href: whats(msg.vaga), whats: true }}
      cta2={{ rotulo: 'Ver as formações', href: '#formacoes' }}
      prova="Aulas 100% práticas com certificado de conclusão."
      foto={{
        src: img('curso-pratica-464.webp'),
        alt: 'Mãos do técnico usando a alavanca de martelinho de ouro sob a barra de luz amarela e o teto de LED hexagonal',
        largura: 464,
        altura: 832,
        ambiente: 'curso-pratica-ambiente.webp',
        posicao: '50% 35%',
      }}
    />

    <!-- FORMAÇÕES ========================================================== -->
    <section class="formacoes" id="formacoes" aria-labelledby="formacoes-titulo">
      <div class="recipiente">
        <div class="sec-cabeca" data-revelar>
          <h2 id="formacoes-titulo">Formações <span class="destaque-cor">disponíveis</span></h2>
          <p class="lead">Escolha a especialidade perfeita para iniciar sua jornada ou faça a formação completa para montar um estúdio premium.</p>
        </div>
        <ul role="list" class="formacoes__lista">
          {cursos.map((c, i) => (
            <li class="curso vidro" data-revelar style={`--atraso: ${i * 0.08}s`}>
              <div class="curso__foto">
                <img src={c.foto.src} width={c.foto.largura} height={c.foto.altura} alt={c.foto.alt} loading="lazy" decoding="async" />
                <span class="pilula curso__etiqueta">{c.etiqueta}</span>
              </div>
              <div class="curso__texto">
                <h3>{c.titulo}</h3>
                <p>{c.texto}</p>
                <a class="btn btn--vidro btn--pequeno" href={whats(c.mensagem)} target="_blank" rel="noopener"><IconeWhats /> Consultar vagas no WhatsApp</a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- OPORTUNIDADE ======================================================= -->
    <section class="oportunidade" aria-labelledby="oportunidade-titulo">
      <div class="recipiente">
        <div class="oportunidade__painel vidro">
        <img class="oportunidade__fundo" src={img('curso-pratica-ambiente.webp')} alt="" aria-hidden="true" width="96" height="172" loading="lazy" />
        <div class="oportunidade__abertura" data-revelar>
          <h2 id="oportunidade-titulo">Uma oportunidade <span class="destaque-cor">à prova de crise</span></h2>
          <p class="lead">O mercado automotivo brasileiro é um dos maiores do mundo. Independentemente do cenário econômico, as pessoas continuam apaixonadas por seus carros e dispostas a pagar caro por serviços premium de conservação.</p>
        </div>
        <div class="oportunidade__corpo" data-revelar>
          <p class="oportunidade__destaque">O grande problema? <span class="destaque-cor">Faltam profissionais verdadeiramente qualificados.</span></p>
          <p class="texto">Sobram "lavadores", mas faltam especialistas em detalhamento e reparo sem repintura.</p>
          <p class="texto">É aqui que você entra. Ao dominar as técnicas da LM Estética Automotiva, você não está aprendendo apenas uma profissão; você está adquirindo o passaporte para abrir sua própria empresa, ditar seus horários e escalar seus lucros entregando excelência.</p>
        </div>
        </div>
      </div>
    </section>

    <Especificacoes id="por-que" titulo="Por que se formar" destaque="na LM?" itens={motivos} />

    <Faq
      lead="Ainda não tem certeza se é para você? Veja as respostas para as principais dúvidas de nossos alunos."
      itens={perguntas}
    >
      <a class="btn btn--vidro" href={whats(msg.duvida)} target="_blank" rel="noopener"><IconeWhats /> Minha dúvida não está aqui</a>
    </Faq>

    <CtaFinal
      titulo="As turmas são reduzidas para garantir o aprendizado."
      texto="Para mantermos a alta qualidade prática, limitamos o número de alunos por turma. Fale com nossa equipe agora para verificar as próximas datas disponíveis e garantir sua vaga."
      botao="Verificar disponibilidade no WhatsApp"
      mensagem={msg.disponibilidade}
      nota="Atendimento humano. Resposta em até 5 minutos no horário comercial."
    />
  </main>

  <Rodape />
  <BarraWhats mensagem={msg.flutuante} rotulo="Falar com consultor no WhatsApp" />
</Base>

<style>
  /* =================================================================
     FORMAÇÕES: três cartões de vidro com foto
     ================================================================= */
  .formacoes { padding-top: var(--secao); }
  .formacoes__lista { display: grid; gap: 1rem; }
  .curso { display: grid; gap: 1.25rem; align-content: start; padding: 0.6rem 0.6rem 1.5rem; }
  .curso__foto {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 16px;
  }
  .curso__foto img { width: 100%; height: 100%; object-fit: cover; }
  .curso__etiqueta {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.3rem 0.8rem;
    background: rgba(46, 143, 214, 0.7);
    border-color: rgba(255, 255, 255, 0.35);
    font-size: 0.8125rem;
  }
  .curso__texto { display: grid; gap: 1rem; justify-items: start; padding-inline: 0.75rem; }
  .curso__texto h3 { font-size: clamp(2rem, 1.7rem + 1.2vw, 2.75rem); }
  .curso__texto p { color: var(--texto-2); }

  @media (min-width: 64rem) {
    .formacoes__lista { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
    .curso__foto { aspect-ratio: 4 / 5; }
  }

  /* =================================================================
     OPORTUNIDADE: painel de vidro com a luz da oficina ao fundo
     ================================================================= */
  .oportunidade { padding-top: var(--secao); }
  .oportunidade__painel { display: grid; gap: 2rem; overflow: hidden; padding: 2rem 1.5rem; --raio: 28px; }
  .oportunidade__fundo {
    position: absolute;
    inset: -10%;
    z-index: -2;
    width: 120%;
    max-width: none;
    height: 120%;
    object-fit: cover;
    opacity: 0.4; /* o desfoque já vem na imagem */
  }
  .oportunidade__abertura,
  .oportunidade__corpo { display: grid; gap: 1.25rem; align-content: start; }
  .oportunidade__abertura .lead { max-width: 40ch; color: rgba(242, 245, 248, 0.88); }
  .oportunidade__corpo .texto { color: rgba(242, 245, 248, 0.82); }
  .oportunidade__destaque {
    font-family: var(--f-titulo);
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 4rem);
    line-height: 0.95;
  }

  @media (min-width: 60rem) {
    .oportunidade__painel { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 4rem; padding: 4rem; }
  }
</style>
