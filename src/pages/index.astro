---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import BarraWhats from '../components/BarraWhats.astro';
import Comparador from '../components/Comparador.astro';
import IconeWhats from '../components/IconeWhats.astro';
import TetoHex from '../components/TetoHex.astro';
import { SITE, UNIDADES, whats, MSG } from '../data/site';

const img = (nome: string) => `/assets/img/${nome}`;

// Martelinho em 3 passos: quadros reais do vídeo do reparo (Nissan Kicks)
const passos = [
  {
    titulo: 'O amassado',
    texto: 'A barra de luz reflete na lataria. Onde as faixas entortam, está o amassado.',
    foto: 'passo-amassado',
    alt: 'Tampa traseira preta de um Nissan Kicks com o reflexo dourado da barra de luz todo entortado pelo amassado',
  },
  {
    titulo: 'O reparo',
    texto: 'Por dentro da lataria, com hastes e ventosas, o metal volta ao formato original. Sem massa, lixa, solvente ou tinta.',
    foto: 'passo-reparo',
    alt: 'Mão do técnico puxando o amassado com a ferramenta de martelinho de ouro',
  },
  {
    titulo: 'O resultado',
    texto: 'Pintura e verniz de fábrica intactos. Pequenos amassados saem em menos de 1 hora.',
    foto: 'passo-resultado',
    alt: 'A mesma tampa traseira lisa, com o reflexo reto e a pintura original brilhando',
  },
];

// Vitrine de serviços. [CONFIRMAR] motos como serviço oficial.
const servicos = [
  { titulo: 'Funilaria especializada', texto: 'Para danos maiores: peças plásticas e metálicas, solda MIG/MAG, spotter e alinhamento técnico da carroceria.', cta: 'Orçamento de funilaria', msg: MSG.funilaria, foto: 'funilaria-yaris-traseira', alt: 'Traseira de um Toyota Yaris prata com o para-choque removido para funilaria', pos: '30% 50%' },
  { titulo: 'Pintura premium', texto: 'Cabine com estufa e colorimetria computadorizada. Retoque ou pintura completa, com acabamento de concessionária.', cta: 'Orçamento de pintura', msg: MSG.pintura, foto: 'pintura-picape-preta', alt: 'Picape preta com a pintura espelhada refletindo as luzes da oficina', pos: '62% 50%' },
  { titulo: 'Polimento e vitrificação', texto: 'Polimento técnico, correção de pintura e revestimento cerâmico: brilho intenso e proteção contra as agressões do dia a dia.', cta: 'Orçamento de polimento', msg: MSG.polimento, foto: 'pintura-porsche-branco', alt: 'Porsche 911 branco com a pintura brilhando sob as luzes da oficina', pos: '35% 50%' },
  { titulo: 'Higienização interna', texto: 'Limpeza profunda por dentro: extração de sujeira, hidratação do couro e oxi-sanitização.', cta: 'Orçamento de higienização', msg: MSG.higienizacao, foto: 'estetica-interior-porsche', alt: 'Interior de couro vermelho de um Porsche depois da higienização', pos: '45% 50%' },
  { titulo: 'Lavagem detalhada', texto: 'Detalhamento minucioso, por dentro e por fora, para o carro sair com cara de concessionária.', cta: 'Orçamento de lavagem', msg: MSG.detalhamento, foto: 'estetica-espuma-defender', alt: 'Land Rover Defender coberto de espuma na lavagem detalhada', pos: '50% 45%' },
  { titulo: 'Motos', texto: 'Estética completa também para motos.', cta: 'Orçamento para moto', msg: MSG.moto, foto: 'estetica-moto-harley', alt: 'Harley-Davidson preta brilhando no estúdio da LM', pos: '40% 60%' },
];
const larguras: Record<string, number[]> = {
  'funilaria-yaris-traseira': [720, 1280],
  'pintura-picape-preta': [720, 1280],
  'pintura-porsche-branco': [720, 1280],
  'estetica-interior-porsche': [720, 1280],
  'estetica-espuma-defender': [600, 1200],
  'estetica-moto-harley': [720, 1280],
};
const srcset = (nome: string) => larguras[nome].map((w) => `${img(`${nome}-${w}.webp`)} ${w}w`).join(', ');

// [CONFIRMAR se são reais] Vieram do site antigo, sem fonte.
const avaliacoes: { nome: string; carro: string; texto: string; link?: string }[] = [
  { nome: 'Maria O.', carro: 'Jeep Compass', texto: 'Levei para fazer martelinho de ouro e fiquei impressionada. Não dá pra ver onde estava o amassado. Recomendo de olhos fechados!' },
  { nome: 'João S.', carro: 'BMW 320i', texto: 'Serviço impecável. Meu carro saiu melhor do que quando tirei da concessionária. O atendimento é outro nível, muito atenciosos.' },
  { nome: 'Carlos P.', carro: 'Honda Civic', texto: 'A vitrificação que fizeram ficou sensacional. O brilho é incrível e a facilidade pra limpar agora é outra. Valeu cada centavo.' },
];
---

<Base
  titulo="Martelinho de ouro em Santo Amaro e Brooklin | LM Estética Automotiva"
  descricao="Martelinho de ouro na Zona Sul de SP: o amassado sai, a pintura original fica, em horas. Funilaria, pintura em cabine com estufa e estética completa em Santo Amaro e no Brooklin."
  caminho="/"
  preloadImagem="/assets/img/hero-poster-464.webp"
>
  <Cabecalho atual="/" />

  <main>
    <!-- HERO: as luzes da oficina acendem ================================= -->
    <section class="hero" data-hero aria-labelledby="hero-titulo">
      <div class="hero__ambiente" aria-hidden="true">
        <video data-hero-ambiente muted playsinline loop preload="none" poster={img('passo-amassado-ambiente.webp')} tabindex="-1">
          <source data-src="/assets/video/hero-ambiente.mp4" type="video/mp4" />
        </video>
      </div>
      <TetoHex class="hero__teto" />
      <div class="hero__vitrine" data-hero-vitrine>
        <video
          class="hero__video"
          data-hero-video
          muted
          playsinline
          loop
          preload="none"
          width="464"
          height="832"
          poster={img('hero-poster-464.webp')}
          aria-hidden="true"
          tabindex="-1"
        >
          <source src="/assets/video/hero.mp4" type="video/mp4" />
        </video>
      </div>
      <button class="hero__pausa" type="button" data-hero-pausa hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="icone-pausa"><path d="M8 5h3v14H8zM13 5h3v14h-3z" fill="currentColor" /></svg>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="icone-tocar"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
        <span class="visualmente-oculto" data-rotulo>Pausar vídeo</span>
      </button>

      <div class="recipiente hero__conteudo" data-hero-conteudo>
        <h1 id="hero-titulo" class="hero__titulo">
          <span class="hero__linha"><span class="cromado">O amassado sai.</span></span>
          <span class="hero__linha"><span class="cromado">A pintura</span></span>
          <span class="hero__linha"><span class="cromado">original fica.</span></span>
        </h1>
        <p class="lead hero__lead">Martelinho de ouro em Santo Amaro e no Brooklin, Zona Sul de SP. Reparo em horas, não em dias.</p>
        <div class="hero__acoes">
          <a class="botao" data-cta-principal href={whats(MSG.geral)} target="_blank" rel="noopener"><IconeWhats /> Pedir orçamento no WhatsApp</a>
          <a class="botao botao--vidro" href="#antes-e-depois">Ver o antes e depois</a>
        </div>
        <!-- [CONFIRMAR se o número continua valendo] -->
        <p class="pequeno hero__prova">+1.000 clientes atendidos em SP</p>
      </div>
      <a class="hero__rolar" href="#martelinho" aria-label="Rolar até o martelinho de ouro"><span aria-hidden="true"></span></a>
    </section>

    <!-- MARTELINHO: o amassado some em 3 passos ========================== -->
    <section class="processo" id="martelinho" aria-labelledby="processo-titulo">
      <div class="recipiente processo__intro">
        <h2 id="processo-titulo" data-titulo><span class="cromado" data-brilho>Pintura de fábrica vale mais</span></h2>
        <p class="lead">Carro repintado perde valor na revenda. O martelinho de ouro tira o amassado sem repintar.</p>
      </div>

      <div class="processo__palco" data-processo-palco>
        <div class="processo__ambiente" aria-hidden="true">
          {passos.map((p) => <img src={img(`${p.foto}-ambiente.webp`)} alt="" width="96" height="172" loading="lazy" decoding="async" />)}
        </div>
        <div class="recipiente processo__grade">
          <div class="processo__contador" aria-hidden="true"><span></span><span></span><span></span></div>
          <ol role="list" class="processo__passos">
            {passos.map((p, i) => (
              <li class="passo">
                <figure class="passo__figura">
                  <img src={img(`${p.foto}-464.webp`)} width="464" height="832" alt={p.alt} loading="lazy" decoding="async" />
                </figure>
                <div class="passo__texto">
                  <span class="passo__num">0{i + 1}</span>
                  <h3><span class="cromado">{p.titulo}</span></h3>
                  <p>{p.texto}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="recipiente processo__fechamento">
        <!-- [CONFIRMAR "até 60%"] -->
        <p class="lead">Até 60% mais barato que funilaria e pintura tradicionais, para o mesmo tipo de dano.</p>
        <a class="botao" href={whats(MSG.martelinho)} target="_blank" rel="noopener"><IconeWhats /> Pedir orçamento de martelinho</a>
      </div>
    </section>

    <!-- ANTES E DEPOIS: a luz atravessa o carro =========================== -->
    <section class="ad" id="antes-e-depois" aria-labelledby="ad-titulo">
      <div class="ad__palco" data-palco style="--ad: 0.5">
        <img class="ad__ambiente" src={img('kicks-ambiente.webp')} alt="" aria-hidden="true" width="96" height="120" loading="lazy" />
        <h2 id="ad-titulo" class="ad__titulo">
          <span class="ad__antes cromado">Antes</span><span class="visualmente-oculto"> e </span><span class="ad__depois cromado">Depois</span>
        </h2>
        <div class="ad__visual">
          <Comparador
            antes={{ src: img('kicks-antes-414.webp'), alt: 'Antes: tampa traseira do Nissan Kicks com amassado; o reflexo da barra de luz aparece entortado' }}
            depois={{ src: img('kicks-depois-414.webp'), alt: 'Depois: a mesma tampa lisa, com o reflexo reto e a pintura original' }}
            largura={414}
            altura={518}
            rotulo="Comparar antes e depois do Nissan Kicks"
          />
        </div>
        <p class="pequeno ad__legenda">Nissan Kicks, tampa traseira. Martelinho de ouro, quadros do vídeo do reparo.</p>
      </div>
      <div class="recipiente ad__mais">
        <div class="espaco-foto">[FOTO: mais pares de antes e depois, do mesmo ângulo e com a mesma luz]</div>
      </div>
    </section>

    <!-- VITRINE DE SERVIÇOS ============================================== -->
    <section class="vitrine" id="servicos" aria-labelledby="vitrine-titulo">
      <div class="vitrine__palco" data-vitrine>
        <div class="recipiente vitrine__cabeca">
          <h2 id="vitrine-titulo" data-titulo><span class="cromado" data-brilho>Além do martelinho</span></h2>
          <p class="lead">Funilaria, pintura em cabine com estufa e estética completa, com o mesmo cuidado.</p>
        </div>
        <div class="vitrine__trilho" data-trilho>
          <ul role="list" class="vitrine__lista" data-lista>
            {servicos.map((s) => (
              <li class="cartao">
                <img
                  src={img(`${s.foto}-${larguras[s.foto][0]}.webp`)}
                  srcset={srcset(s.foto)}
                  sizes="(min-width: 60rem) 30rem, 82vw"
                  width={larguras[s.foto][0]}
                  alt={s.alt}
                  loading="lazy"
                  decoding="async"
                  style={`object-position: ${s.pos}`}
                />
                <div class="cartao__texto">
                  <h3><span class="cromado">{s.titulo}</span></h3>
                  <p>{s.texto}</p>
                  <a class="link-whats" href={whats(s.msg)} target="_blank" rel="noopener"><IconeWhats /> {s.cta}</a>
                </div>
              </li>
            ))}
            <li class="cartao cartao--todos">
              <a href="/servicos" class="cartao__todos">
                <span class="cromado">Ver todos os serviços</span>
                <span class="pequeno">Detalhes de cada serviço e como agendar</span>
              </a>
            </li>
          </ul>
        </div>
        <div class="recipiente vitrine__rodape" aria-hidden="true">
          <div class="vitrine__progresso"><span data-vitrine-progresso></span></div>
          <p class="pequeno vitrine__dica">Deslize para ver os serviços</p>
        </div>
      </div>
    </section>

    <!-- DUAS UNIDADES ===================================================== -->
    <section class="unidades" id="unidades" aria-labelledby="unidades-titulo">
      <div class="recipiente unidades__cabeca">
        <h2 id="unidades-titulo" data-titulo><span class="cromado" data-brilho>Duas unidades na Zona Sul</span></h2>
        <p class="lead">A matriz fica em Santo Amaro. No Brooklin fica a cabine exclusiva de pintura.</p>
      </div>

      <div class="unidades__painel">
        <article class="unidade" aria-labelledby="ua-sa">
          <!-- [CONFIRMAR se esta fachada é a de Santo Amaro] -->
          <div class="unidade__foto" data-parallax>
            <img
              src={img('unidade-santo-amaro-480.webp')}
              srcset={`${img('unidade-santo-amaro-480.webp')} 480w, ${img('unidade-santo-amaro-960.webp')} 960w`}
              sizes="(min-width: 60rem) 50vw, 100vw"
              width="480"
              height="600"
              alt="Fachada da LM Estética Automotiva, com a placa de martelinho de ouro e a oficina iluminada ao fundo"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="unidade__texto">
            <p class="unidade__papel">{UNIDADES.santoAmaro.papel}</p>
            <h3 id="ua-sa"><span class="cromado">{UNIDADES.santoAmaro.nome}</span></h3>
            <address>{UNIDADES.santoAmaro.rua}<br />Santo Amaro, São Paulo, CEP {UNIDADES.santoAmaro.cep}</address>
            <ul role="list" class="unidade__itens">
              <li>Estacionamento gratuito</li>
              <li>Sala de espera climatizada, com Wi-Fi, TV e café</li>
            </ul>
            <a class="botao botao--vidro" href={UNIDADES.santoAmaro.rota} target="_blank" rel="noopener">Abrir rota no Google Maps</a>
          </div>
        </article>

        <article class="unidade unidade--brooklin" aria-labelledby="ua-br">
          <!-- [CONFIRMAR se a cabine das fotos é a do Brooklin] -->
          <div class="unidade__foto" data-parallax data-acender>
            <img
              src={img('cabine-yaris-retrato-600.webp')}
              srcset={`${img('cabine-yaris-retrato-600.webp')} 600w, ${img('cabine-yaris-retrato-960.webp')} 960w`}
              sizes="(min-width: 60rem) 50vw, 100vw"
              width="600"
              height="800"
              alt="Cabine de pintura com paredes de vidro, luzes de LED e um Toyota Yaris prata dentro"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="unidade__texto">
            <p class="unidade__papel">{UNIDADES.brooklin.papel}</p>
            <h3 id="ua-br"><span class="cromado">{UNIDADES.brooklin.nome}</span></h3>
            <p class="unidade__descricao">Cabine fechada com estufa: ambiente sem poeira, secagem na temperatura certa e cor fiel ao padrão de fábrica.</p>
            <address>{UNIDADES.brooklin.rua}<br />Brooklin, São Paulo</address>
            <a class="botao botao--vidro" href={UNIDADES.brooklin.rota} target="_blank" rel="noopener">Abrir rota no Google Maps</a>
          </div>
        </article>
      </div>

      <!-- [CONFIRMAR horário do Brooklin] -->
      <p class="recipiente pequeno unidades__horario">Segunda a sexta, das 8h às 18h. Sábado, das 8h às 16h.</p>
    </section>

    <!-- AVALIAÇÕES ======================================================== -->
    <section class="avaliacoes" aria-labelledby="avaliacoes-titulo">
      <div class="recipiente">
        <h2 id="avaliacoes-titulo" data-titulo><span class="cromado" data-brilho>Quem já trouxe o carro</span></h2>
        <ul role="list" class="avaliacoes__lista">
          {avaliacoes.map((a) => (
            <li class="avaliacao">
              <blockquote><p>{a.texto}</p></blockquote>
              <p class="avaliacao__autor">
                {a.link ? <a href={a.link} target="_blank" rel="noopener"><strong>{a.nome}</strong></a> : <strong>{a.nome}</strong>}
                <span>{a.carro}</span>
              </p>
            </li>
          ))}
        </ul>
        <a class="botao botao--vidro" href={SITE.avaliacoesGoogle} target="_blank" rel="noopener">Ver avaliações no Google</a>
      </div>
    </section>

    <!-- CTA FINAL ========================================================= -->
    <section class="final" aria-labelledby="final-titulo">
      <img class="final__fundo" src={img('luz-lataria-ambiente.webp')} alt="" aria-hidden="true" width="96" height="172" loading="lazy" />
      <div class="recipiente final__grade">
        <div class="final__texto">
          <h2 id="final-titulo" data-titulo><span class="cromado" data-brilho>Mande a foto do amassado</span></h2>
          <p class="lead">Receba um pré-orçamento pelo WhatsApp, sem compromisso.</p>
          <a class="botao" data-cta-principal href={whats(MSG.foto)} target="_blank" rel="noopener"><IconeWhats /> Enviar foto pelo WhatsApp</a>
          <!-- [CONFIRMAR se continua valendo] -->
          <p class="pequeno">Resposta em menos de 2 minutos no horário comercial.</p>
        </div>
        <div class="final__selo" data-selo>
          <img src={img('logo-lm-480.webp')} width="480" height="479" alt="" loading="lazy" decoding="async" />
        </div>
      </div>
    </section>
  </main>

  <Rodape />
  <BarraWhats />
</Base>

<style>
  /* =================================================================
     HERO
     ================================================================= */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: 100svh;
    padding-block: calc(var(--altura-topo) + 2rem) 2.5rem;
    overflow: hidden;
  }
  .hero__ambiente { display: none; }
  .hero__vitrine {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__video { width: 100%; height: 100%; object-fit: cover; }
  .hero__vitrine::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(5, 8, 13, 0.98) 0%, rgba(5, 8, 13, 0.82) 34%, rgba(5, 8, 13, 0.15) 64%, rgba(5, 8, 13, 0.6) 100%);
  }
  .hero :global(.hero__teto) {
    position: absolute;
    inset: 0 0 auto 0;
    height: 44svh;
    z-index: -1;
    opacity: 0.6;
    mix-blend-mode: screen;
  }

  .hero__titulo { font-size: var(--t-hero); line-height: 0.9; }
  .hero__linha { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .hero__linha > span { display: inline-block; }
  .hero__lead { margin-top: 1.25rem; }
  .hero__acoes { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .hero__acoes .botao { flex: 1 1 100%; }
  .hero__prova { margin-top: 0.875rem; }

  .hero__pausa {
    position: absolute;
    top: calc(var(--altura-topo) + 0.75rem);
    right: var(--gutter);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(242, 245, 248, 0.35);
    border-radius: 50%;
    background: rgba(5, 8, 13, 0.5);
    color: var(--branco);
    cursor: pointer;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .hero__pausa svg { width: 1.125rem; height: 1.125rem; }
  .hero__pausa .icone-tocar { display: none; }
  .hero__pausa[data-pausado] .icone-pausa { display: none; }
  .hero__pausa[data-pausado] .icone-tocar { display: block; }

  .hero__rolar { display: none; }

  :global(.mov) .hero__linha > span,
  :global(.mov) .hero__lead,
  :global(.mov) .hero__acoes,
  :global(.mov) .hero__prova { visibility: hidden; }
  :global(.mov) .hero__vitrine { opacity: 0; }

  @media (min-width: 40rem) {
    .hero__acoes .botao { flex: 0 0 auto; }
  }

  @media (min-width: 60rem) {
    .hero {
      align-items: center;
      padding-block: var(--altura-topo) 0;
    }
    /* luz ambiente: o próprio vídeo, minúsculo e desfocado, enchendo a tela */
    .hero__ambiente {
      display: block;
      position: absolute;
      inset: -12%;
      z-index: -3;
      opacity: 0.75;
    }
    .hero__ambiente video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: blur(26px) saturate(1.5) brightness(0.62);
    }
    .hero__ambiente::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(5, 8, 13, 0.92) 0%, rgba(5, 8, 13, 0.55) 45%, rgba(5, 8, 13, 0.2) 100%);
    }
    .hero :global(.hero__teto) { height: 58vh; opacity: 0.95; }

    /* o vídeo vira um "display" de vitrine, com reflexo no chão */
    .hero__vitrine {
      inset: auto;
      top: calc(var(--altura-topo) + 3.5vh);
      right: max(var(--gutter), calc((100vw - var(--largura)) / 2));
      height: calc(100svh - var(--altura-topo) - 16vh);
      aspect-ratio: 464 / 832;
      z-index: 0;
    }
    .hero__vitrine::after { content: none; }
    .hero__video {
      border-radius: 12px;
      border: 1px solid rgba(220, 236, 248, 0.4);
      box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.9), 0 0 70px -10px rgba(77, 181, 220, 0.45);
      -webkit-box-reflect: below 14px linear-gradient(transparent 72%, rgba(255, 255, 255, 0.22));
    }
    .hero__conteudo { padding-block: 4rem; }
    .hero__titulo,
    .hero__lead { max-width: calc(100% - 25rem); }
    .hero__pausa { top: auto; bottom: 2rem; right: calc(max(var(--gutter), calc((100vw - var(--largura)) / 2)) + 1rem); }

    .hero__rolar {
      position: absolute;
      left: 50%;
      bottom: 1.5rem;
      display: block;
      width: 1.5rem;
      height: 2.75rem;
      transform: translateX(-50%);
      border: 1px solid rgba(220, 236, 248, 0.45);
      border-radius: 999px;
    }
