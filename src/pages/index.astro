---
// Home: foto de fundo, vidro líquido, cor da marca e caixas.
// Sem seção que trava a tela na rolagem.
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import BarraWhats from '../components/BarraWhats.astro';
import Comparador from '../components/Comparador.astro';
import Orcamento from '../components/Orcamento.astro';
import IconeWhats from '../components/IconeWhats.astro';
import Textura from '../components/Textura.astro';
import { SITE, UNIDADES, whats, MSG } from '../data/site';

const img = (nome: string) => `/assets/img/${nome}`;

const servicos = [
  { nome: 'Martelinho de ouro', apoio: 'O amassado sai, a pintura original fica', href: '/martelinho', foto: 'martelinho-tecnico-464.webp', w: 464, h: 580, classe: 'card--grande' },
  { nome: 'Funilaria', apoio: 'Para danos maiores', href: '/servicos#funilaria', foto: 'funilaria-yaris-traseira-720.webp', w: 720, h: 405 },
  { nome: 'Pintura', apoio: 'Cabine com estufa no Brooklin', href: '/servicos#pintura', foto: 'cabine-yaris-ampla-720.webp', w: 720, h: 405 },
  { nome: 'Estética e motos', apoio: 'Polimento, vitrificação e higienização', href: '/servicos#estetica', foto: 'estetica-moto-harley-720.webp', w: 720, h: 378, classe: 'card--largo' },
];

const avaliacoes = [
  { nome: 'Maria O.', carro: 'Jeep Compass', texto: 'Levei para fazer martelinho de ouro e fiquei impressionada. Não dá pra ver onde estava o amassado. Recomendo de olhos fechados!' },
  { nome: 'João S.', carro: 'BMW 320i', texto: 'Serviço impecável. Meu carro saiu melhor do que quando tirei da concessionária. O atendimento é outro nível, muito atenciosos.' },
  { nome: 'Ana C.', carro: 'Hyundai Creta', texto: 'Fizeram a funilaria e pintura do meu para-choque. A cor ficou idêntica, serviço rápido e com um preço justo. Profissionais de verdade.' },
  { nome: 'Carlos P.', carro: 'Honda Civic', texto: 'A vitrificação que fizeram ficou sensacional. O brilho é incrível e a facilidade pra limpar agora é outra. Valeu cada centavo.' },
];
---

<Base
  titulo="Especialistas em martelinho de ouro em Santo Amaro e Brooklin | LM Estética Automotiva"
  descricao="Especialistas em martelinho de ouro na Zona Sul de SP: o amassado sai, a pintura original fica, em horas. Orçamento pelo WhatsApp com resposta em menos de 2 minutos. Santo Amaro e Brooklin."
  caminho="/"
  preloadImagem={img('hero-carro-retrato-700.webp')}
  estilo="vidro"
>
  <Cabecalho />

  <main>
    <!-- 1. TOPO ========================================================== -->
    <section class="h" aria-labelledby="hero-titulo">
      <picture>
        <source media="(min-width: 48rem)" srcset={`${img('hero-carro-960.webp')} 960w, ${img('hero-carro-1600.webp')} 1600w`} sizes="100vw" />
        <img class="h__foto" src={img('hero-carro-retrato-700.webp')} width="700" height="1191" alt="Picape preta com a pintura espelhada no estúdio da LM" fetchpriority="high" />
      </picture>
      <!-- [FOTO provisória: trocar por uma foto profissional do carro-destaque] -->

      <div class="recipiente h__grade">
        <div class="h__texto" data-revelar>
          <p class="pilula"><span class="ponto-vivo"></span> Especialistas em martelinho de ouro</p>
          <h1 id="hero-titulo" class="h__titulo"><span>O amassado sai.</span> <span class="destaque-cor">A pintura</span> <span class="destaque-cor">original fica.</span></h1>
          <p class="h__lead">Martelinho de ouro, funilaria, pintura e estética em Santo Amaro e no Brooklin. Reparo em horas, não em dias.</p>
          <div class="h__acoes">
            <a class="btn btn--primario" href="#orcamento" data-cta-principal>Fazer orçamento</a>
            <a class="btn btn--vidro" href={whats(MSG.geral)} target="_blank" rel="noopener"><IconeWhats /> Falar no WhatsApp</a>
          </div>
          <ul role="list" class="h__provas">
            <li class="pilula">+1.000 clientes em SP</li>
            <li class="pilula">Resposta em menos de 2 min</li>
            <li class="pilula">Garantia em todos os serviços</li>
          </ul>
        </div>

        <div class="h__cartoes">
          <figure class="h__cartao vidro" data-revelar style="--atraso: 0.15s">
            <p class="estrelas" aria-label="5 estrelas">★★★★★</p>
            <blockquote><p>"Não dá pra ver onde estava o amassado."</p></blockquote>
            <figcaption>Maria O. · Jeep Compass</figcaption>
          </figure>
          <div class="h__cartao h__status vidro" data-revelar style="--atraso: 0.3s" data-funcionamento>
            <p class="h__status-linha"><span class="ponto-vivo" data-funcionamento-ponto></span> <strong data-funcionamento-texto>Seg a sex, 8h às 18h</strong></p>
            <p class="pequeno" data-funcionamento-detalhe>Sábado, 8h às 16h · Santo Amaro e Brooklin</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. POR QUE MARTELINHO: caixas =================================== -->
    <section class="sec" aria-labelledby="bento-titulo">
      <Textura tipo="hex" onde="direita" />
      <div class="recipiente">
        <div class="sec-cabeca" data-revelar>
          <p class="pilula">Martelinho de ouro</p>
          <h2 id="bento-titulo">A pintura de fábrica <span class="destaque-cor">vale mais</span></h2>
          <p class="lead">Carro repintado perde valor na revenda. O martelinho tira o amassado sem repintar.</p>
        </div>

        <div class="bento">
          <article class="bento__ad vidro" data-revelar>
            <div class="bento__comparador">
              <Comparador
                antes={{ src: img('kicks-antes-414.webp'), alt: 'Antes: tampa traseira do Nissan Kicks com amassado; o reflexo da barra de luz aparece entortado' }}
                depois={{ src: img('kicks-depois-414.webp'), alt: 'Depois: a mesma tampa lisa, com o reflexo reto e a pintura original' }}
                largura={414}
                altura={518}
                rotulo="Comparar antes e depois do Nissan Kicks"
              />
            </div>
            <div class="bento__ad-texto">
              <p class="pilula">Antes e depois</p>
              <h3>Arraste a barra de luz</h3>
              <p>Mesmo carro, mesma luz. Só o amassado saiu, a pintura continua a original de fábrica.</p>
              <a class="btn btn--vidro btn--pequeno" href="/martelinho">Como funciona</a>
            </div>
          </article>

          <article class="bento__item bento__destaque" data-revelar style="--atraso: 0.05s">
            <span class="bento__icone" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><path d="M8.5 12l2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <span class="bento__numero">100%</span>
            <p>da pintura e do verniz de fábrica mantidos.</p>
          </article>
          <article class="bento__item vidro" data-revelar style="--atraso: 0.1s">
            <span class="bento__icone" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></span>
            <span class="bento__numero">Horas</span>
            <p>não dias. Pequenos danos saem em menos de 1 hora.</p>
          </article>
          <article class="bento__item vidro" data-revelar style="--atraso: 0.15s">
            <span class="bento__icone" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12.5V5a1 1 0 011-1h7.5L20 11.5 12.5 19 4 12.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><circle cx="8.5" cy="8.5" r="1.4" fill="currentColor" /></svg></span>
            <span class="bento__numero">60%</span>
            <p>até 60% mais barato que funilaria e pintura.</p>
          </article>
          <article class="bento__item vidro" data-revelar style="--atraso: 0.2s">
            <span class="bento__icone" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="9.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M8.5 14l-1.5 7 5-2.5 5 2.5-1.5-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg></span>
            <span class="bento__numero">Garantia</span>
            <p>em todos os serviços.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- 3. ORÇAMENTO ====================================================== -->
    <Orcamento />

    <!-- 4. SERVIÇOS ======================================================= -->
    <section class="sec sec--piso" aria-labelledby="servicos-titulo">
      <Textura tipo="piso" onde="base" />
      <div class="recipiente">
        <div class="sec-cabeca" data-revelar>
          <p class="pilula">Serviços</p>
          <h2 id="servicos-titulo">Do reparo <span class="destaque-cor">à perfeição</span></h2>
        </div>
        <div class="cards">
          {servicos.map((s, i) => (
            <a class:list={['card', s.classe]} href={s.href} data-revelar style={`--atraso: ${i * 0.06}s`}>
              <img src={img(s.foto)} width={s.w} height={s.h} alt="" loading="lazy" decoding="async" />
              <span class="card__info vidro">
                <span class="card__texto"><strong>{s.nome}</strong><span>{s.apoio}</span></span>
                <span class="card__seta" aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. UNIDADES ======================================================= -->
    <section class="sec" aria-labelledby="unidades-titulo">
      <Textura tipo="hex" onde="esquerda" />
      <div class="recipiente">
        <div class="sec-cabeca" data-revelar>
          <p class="pilula">Zona Sul de SP</p>
          <h2 id="unidades-titulo">Duas unidades, <span class="destaque-cor">perto de você</span></h2>
        </div>
        <div class="unid">
          <article class="unid__card" data-revelar>
            <!-- [CONFIRMAR se esta fachada é a de Santo Amaro] -->
            <img src={img('unidade-santo-amaro-480.webp')} srcset={`${img('unidade-santo-amaro-480.webp')} 480w, ${img('unidade-santo-amaro-960.webp')} 960w`} sizes="(min-width: 60rem) 45vw, 100vw" width="480" height="600" alt="Fachada da LM Estética Automotiva em Santo Amaro" loading="lazy" decoding="async" />
            <div class="unid__info vidro">
              <p class="pilula">Matriz</p>
              <h3>{UNIDADES.santoAmaro.nome}</h3>
              <p>{UNIDADES.santoAmaro.rua}. Estacionamento gratuito e sala de espera com café.</p>
              <a class="btn btn--vidro btn--pequeno" href={UNIDADES.santoAmaro.rota} target="_blank" rel="noopener">Como chegar</a>
            </div>
          </article>
          <article class="unid__card" data-revelar style="--atraso: 0.1s">
            <!-- [CONFIRMAR se a cabine das fotos é a do Brooklin] -->
            <img src={img('cabine-yaris-retrato-600.webp')} srcset={`${img('cabine-yaris-retrato-600.webp')} 600w, ${img('cabine-yaris-retrato-960.webp')} 960w`} sizes="(min-width: 60rem) 45vw, 100vw" width="600" height="800" alt="Cabine de pintura com estufa no Brooklin" loading="lazy" decoding="async" />
            <div class="unid__info vidro">
              <p class="pilula">Cabine de pintura com estufa</p>
              <h3>{UNIDADES.brooklin.nome}</h3>
              <p>{UNIDADES.brooklin.rua}. Ambiente sem poeira e cor fiel ao original.</p>
              <a class="btn btn--vidro btn--pequeno" href={UNIDADES.brooklin.rota} target="_blank" rel="noopener">Como chegar</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 6. AVALIAÇÕES ===================================================== -->
    <section class="sec" aria-labelledby="avaliacoes-titulo">
      <Textura tipo="carbono" onde="topo" />
      <div class="recipiente">
        <div class="sec-cabeca sec-cabeca--linha" data-revelar>
          <div>
            <p class="pilula"><span class="estrelas">★★★★★</span> Clientes</p>
            <h2 id="avaliacoes-titulo">Quem já trouxe <span class="destaque-cor">o carro</span></h2>
          </div>
          <a class="btn btn--vidro btn--pequeno" href={SITE.avaliacoesGoogle} target="_blank" rel="noopener">Ver no Google</a>
        </div>
        <div class="avals" tabindex="0" role="region" aria-label="Avaliações de clientes">
          {avaliacoes.map((a, i) => (
            <figure class="aval vidro" data-revelar style={`--atraso: ${i * 0.06}s`}>
              <p class="estrelas" aria-label="5 estrelas">★★★★★</p>
              <blockquote><p>{a.texto}</p></blockquote>
              <figcaption class="aval__autor">
                <span class="aval__avatar" aria-hidden="true">{a.nome[0]}</span>
                <span><strong>{a.nome}</strong><span>{a.carro}</span></span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. CHAMADA FINAL ================================================== -->
    <section class="sec cta" aria-labelledby="cta-titulo">
      <div class="recipiente">
        <div class="cta__painel" data-revelar>
          <Textura tipo="hex" onde="direita" />
          <p class="pilula"><span class="ponto-vivo ponto-vivo--verde"></span> Resposta em menos de 2 minutos</p>
          <h2 id="cta-titulo">Mande a foto do amassado</h2>
          <p class="cta__texto">Receba um pré-orçamento pelo WhatsApp, sem compromisso.</p>
          <div class="h__acoes">
            <a class="btn btn--whats" href={whats(MSG.foto)} target="_blank" rel="noopener" data-cta-principal><IconeWhats /> Enviar foto pelo WhatsApp</a>
            <a class="btn btn--vidro" href="#orcamento">Montar orçamento</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Rodape />
  <BarraWhats />
</Base>

<script>
  // "Aberto agora": horário de São Paulo (seg a sex 8h–18h, sáb 8h–16h)
  const caixa = document.querySelector<HTMLElement>('[data-funcionamento]');
  if (caixa) {
    const agora = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Sao_Paulo' }));
    const dia = agora.getDay();
    const min = agora.getHours() * 60 + agora.getMinutes();
    const fecha = dia >= 1 && dia <= 5 ? 18 : dia === 6 ? 16 : 0;
    const aberto = fecha > 0 && min >= 8 * 60 && min < fecha * 60;
    let texto: string;
    if (aberto) texto = `Aberto agora · até ${fecha}h`;
    else if (fecha > 0 && min < 8 * 60) texto = 'Fechado · abre hoje às 8h';
    else if (dia === 5) texto = 'Fechado · abre sábado às 8h';
    else if (dia === 6 || dia === 0) texto = 'Fechado · abre segunda às 8h';
    else texto = 'Fechado · abre amanhã às 8h';
    caixa.querySelector('[data-funcionamento-texto]')!.textContent = texto;
    caixa.querySelector('[data-funcionamento-ponto]')!.className = `ponto-vivo ${aberto ? 'ponto-vivo--verde' : 'ponto-vivo--cinza'}`;
    caixa.querySelector('[data-funcionamento-detalhe]')!.textContent = 'Seg a sex 8h–18h · Sáb 8h–16h';
  }
</script>

<style>
  /* =================================================================
     TOPO
     ================================================================= */
  .h {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: 100svh;
    padding: calc(var(--altura-topo) + 2rem) 0 2.5rem;
    overflow: hidden;
  }
  .h__foto { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 60% 45%; }
  .h::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgba(6, 17, 32, 0.98) 0%, rgba(6, 17, 32, 0.8) 38%, rgba(6, 17, 32, 0.1) 68%, rgba(6, 17, 32, 0.6) 100%),
      radial-gradient(90% 60% at 0% 100%, rgba(46, 143, 214, 0.4), transparent 70%);
  }
  .h__grade { display: grid; gap: 2rem; }
  .h__texto { display: grid; gap: 1.1rem; justify-items: start; }
  .h__titulo { font-size: clamp(3.25rem, 1.4rem + 6.6vw, 7.25rem); line-height: 0.92; }
  .h__titulo > span { display: block; }
  .h__lead { font-family: var(--f-apoio); font-size: var(--t-lead); line-height: 1.35; color: rgba(242, 245, 248, 0.88); max-width: 34ch; }
  .h__acoes { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.4rem; }
  .h__provas { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
  .h__provas .pilula { font-weight: 400; font-size: 0.8125rem; }
  .h__cartoes { display: none; }

  @media (min-width: 60rem) {
    .h { align-items: center; padding-block: calc(var(--altura-topo) + 3rem) 4rem; }
    .h__foto { object-position: 50% 55%; }
    .h::before {
      background:
        linear-gradient(90deg, rgba(6, 17, 32, 0.95) 0%, rgba(6, 17, 32, 0.72) 42%, rgba(6, 17, 32, 0.12) 78%),
        linear-gradient(to top, rgba(6, 17, 32, 0.9) 0%, rgba(6, 17, 32, 0) 35%),
        radial-gradient(70% 70% at 0% 100%, rgba(46, 143, 214, 0.35), transparent 70%);
    }
    .h__grade { grid-template-columns: minmax(0, 1fr) 20rem; align-items: end; gap: 4rem; }
    .h__texto { max-width: 44rem; }
    .h__cartoes { display: grid; gap: 1rem; }
    .h__cartao { margin: 0; padding: 1.25rem 1.4rem; display: grid; gap: 0.6rem; }
    .h__cartao blockquote p { font-family: var(--f-titulo); font-size: 1.75rem; line-height: 1; }
    .h__cartao figcaption { font-family: var(--f-apoio); font-size: 0.875rem; color: rgba(242, 245, 248, 0.75); }
    .h__status-linha { display: flex; align-items: center; gap: 0.6rem; font-family: var(--f-apoio); }
  }

  /* =================================================================
     SEÇÕES
     ================================================================= */
  .sec { position: relative; isolation: isolate; padding-block: var(--secao) 0; }
  .sec--piso { padding-bottom: 4rem; }
  .sec-cabeca--linha { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem; width: 100%; }
  .sec-cabeca--linha > div { display: grid; gap: 1rem; justify-items: start; }

  /* caixas do martelinho */
  .bento { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; }
  .bento__ad { grid-column: 1 / -1; display: grid; gap: 1.25rem; padding: 0.75rem 0.75rem 1.5rem; }
  .bento__comparador :global(.comparar__quadro) { border-radius: 16px; }
  .bento__ad-texto { display: grid; gap: 0.75rem; justify-items: start; padding-inline: 0.75rem; }
  .bento__ad-texto h3 { font-size: clamp(2rem, 1.6rem + 1.6vw, 2.75rem); }
  .bento__ad-texto p:not(.pilula) { color: var(--texto-2); }
  .bento__item { display: grid; gap: 0.4rem; align-content: start; padding: 1.1rem; }
  .bento__icone {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.4rem;
    border-radius: 12px;
    background: rgba(92, 200, 240, 0.16);
    color: #8fdcff;
  }
  .bento__icone svg { width: 1.35rem; height: 1.35rem; }
  .bento__numero { font-family: var(--f-titulo); font-size: clamp(2.25rem, 1.7rem + 2.2vw, 3.75rem); line-height: 0.95; }
  .bento__item p { color: var(--texto-2); font-size: 0.9375rem; line-height: 1.4; }
  .bento__destaque {
    border-radius: var(--raio);
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: linear-gradient(150deg, #43a8ec 0%, #1f6fb2 55%, #123f6a 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 24px 48px -22px rgba(46, 143, 214, 0.9);
  }
  .bento__destaque p { color: rgba(255, 255, 255, 0.92); }
  .bento__destaque .bento__icone { background: rgba(255, 255, 255, 0.2); color: #fff; }

  @media (min-width: 48rem) {
    .bento__ad { grid-template-columns: minmax(0, 18rem) minmax(0, 1fr); align-items: center; padding: 0.9rem 1.5rem 0.9rem 0.9rem; }
  }
  @media (min-width: 64rem) {
    .bento { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.1rem; }
    .bento__ad { grid-column: 1 / 3; grid-row: 1 / 3; grid-template-columns: minmax(0, 17rem) minmax(0, 1fr); }
    .bento__item { padding: 1.5rem; }
  }

  /* cards de serviço */
  .cards { display: grid; gap: 1rem; }
  .card {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: 17rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--raio);
    text-decoration: none;
  }
  .card img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s var(--curva); }
  .card::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgba(6, 17, 32, 0.7), rgba(6, 17, 32, 0) 55%); }
  .card:hover img { transform: scale(1.06); }
  .card__info { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 0.75rem; padding: 0.9rem 0.9rem 0.9rem 1.2rem; --raio: 16px; }
  .card__texto { display: grid; gap: 0.2rem; }
  .card__texto strong { font-family: var(--f-titulo); font-weight: 400; font-size: 1.9rem; line-height: 1; }
  .card__texto span { font-family: var(--f-apoio); font-size: 0.875rem; color: rgba(242, 245, 248, 0.82); }
  .card__seta {
    display: grid;
    place-items: center;
    flex: none;
