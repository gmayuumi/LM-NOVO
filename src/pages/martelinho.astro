---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import BarraWhats from '../components/BarraWhats.astro';
import HeroInterno from '../components/HeroInterno.astro';
import Especificacoes from '../components/Especificacoes.astro';
import Processo from '../components/Processo.astro';
import Comparador from '../components/Comparador.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import IconeWhats from '../components/IconeWhats.astro';
import { whats } from '../data/site';

const img = (nome: string) => `/assets/img/${nome}`;

// Mensagens do WhatsApp desta página (as mesmas do site antigo)
const msg = {
  pagina: 'Olá! Gostaria de fazer um orçamento para Martelinho de Ouro.',
  avaliacao: 'Olá! Gostaria de uma avaliação online grátis para o serviço de martelinho.',
  foto: 'Olá! Quero enviar uma foto para um orçamento de Martelinho de Ouro.',
};

// Textos do site antigo (docs/conteudo-site-atual.md, 3.2)
const beneficios = [
  { titulo: '100% original', texto: 'Mantém a pintura e o verniz de fábrica, evitando a desvalorização do veículo causada por repinturas.' },
  { titulo: 'Rapidez incomparável', texto: 'Reparos concluídos em poucas horas, não em dias. Você não fica sem o seu carro quando mais precisa.' },
  { titulo: 'Custo-benefício', texto: 'Até 60% mais econômico que os serviços de funilaria e pintura tradicionais para o mesmo tipo de dano.' },
  { titulo: 'Solução ecológica', texto: 'Não utiliza massas, lixas, solventes ou tintas, contribuindo para a preservação do meio ambiente.' },
];

// Quadros reais do vídeo do reparo (Nissan Kicks)
const passos = [
  {
    titulo: 'Análise detalhada',
    texto: 'Avaliamos o amassado com iluminação especial para definir a melhor técnica e ferramenta, garantindo acesso sem desmontagens desnecessárias.',
    foto: 'passo-analise',
    alt: 'Traseira de um Nissan Kicks preto sob a barra de luz; o reflexo dourado entorta onde está o amassado',
  },
  {
    titulo: 'Acesso à área',
    texto: 'Utilizamos hastes de aço e ventosas especiais para acessar a parte interna da lataria, preparando a área para a massagem do metal.',
    foto: 'passo-reparo',
    alt: 'Mão do técnico posicionando a ferramenta de martelinho de ouro na tampa traseira',
  },
  {
    titulo: 'Reparo artesanal',
    texto: 'Com movimentos precisos, o metal é suavemente "massageado" de volta à sua forma original, eliminando o dano de forma definitiva.',
    foto: 'luz-lataria',
    alt: 'Close da lataria preta com o reflexo dourado da barra de luz e a ferramenta de ponta vermelha trabalhando o metal',
  },
  {
    titulo: 'Inspeção e acabamento',
    texto: 'Uma inspeção final sob luzes de LED e um polimento técnico na área garantem que o resultado seja absolutamente imperceptível.',
    foto: 'passo-resultado',
    alt: 'A tampa traseira lisa, com o reflexo reto e a pintura original brilhando',
  },
];

// "Que amassado sai com martelinho?": tirado das respostas do FAQ do site antigo
const resolve = [
  { tipo: 'sim', titulo: 'Sai com martelinho', itens: ['Batida de porta em estacionamento', 'Chuva de granizo', 'Pequenas colisões', 'Impacto de objetos'] },
  { tipo: 'talvez', titulo: 'Pede avaliação mais criteriosa', itens: ['Amassado em vinco', 'Peças de alumínio'], nota: 'Trabalhamos com alumínio. O reparo pode ser mais complexo e demorado.' },
  { tipo: 'nao', titulo: 'Não é caso de martelinho', itens: ['Pintura trincada ou arranhada'], nota: 'Aí o caminho é funilaria e pintura, que a LM também faz.', link: { rotulo: 'Ver funilaria e pintura', href: '/servicos#funilaria' } },
];

const perguntas = [
  {
    pergunta: 'Que tipo de amassado o martelinho de ouro conserta?',
    resposta: 'A técnica é ideal para amassados onde a pintura não foi danificada (trincada ou arranhada). Isso inclui danos de chuva de granizo, batidas de porta em estacionamentos, pequenas colisões e amassados por impacto de objetos. Amassados em vincos ou em peças de alumínio podem exigir uma avaliação mais criteriosa.',
  },
  {
    pergunta: 'O amassado pode voltar depois do reparo?',
    resposta: 'Não. Uma vez que o metal é corretamente moldado de volta à sua forma original, ele ganha "memória" e o reparo é permanente. O amassado não voltará a aparecer, a menos que a área sofra um novo impacto. Oferecemos garantia total sobre nossos serviços.',
  },
  {
    pergunta: 'Meu carro tem o painel de alumínio. O serviço funciona?',
    resposta: 'Sim, trabalhamos com painéis de alumínio. No entanto, o alumínio é um material com menos "memória" que o aço e exige ferramentas e técnicas específicas. O reparo pode ser mais complexo e demorado, mas nossa equipe é qualificada para lidar com ambos os materiais com excelência.',
  },
  {
    pergunta: 'Quanto tempo leva o serviço?',
    resposta: 'O tempo varia com o tamanho, localização e complexidade do amassado. Pequenos danos podem ser resolvidos em menos de 1 hora. Casos mais complexos, como múltiplos danos de granizo, podem levar um dia inteiro. A grande vantagem é que quase sempre o serviço é concluído no mesmo dia.',
  },
];
---

<Base
  titulo="Martelinho de ouro em Santo Amaro, Zona Sul de SP | LM Estética Automotiva"
  descricao="Martelinho de ouro em Santo Amaro, Zona Sul de SP. Removemos amassados da lataria preservando 100% a pintura original. Orçamento rápido pelo WhatsApp e serviço em horas."
  caminho="/martelinho"
  preloadImagem={img('martelinho-tecnico-464.webp')}
>
  <Cabecalho atual="/martelinho" />

  <main>
    <HeroInterno
      titulo={['Preserve a', 'originalidade.', 'Apague a', 'imperfeição.']}
      subtitulo="A solução definitiva em martelinho de ouro"
      texto="Nossa técnica artesanal remove amassados com precisão cirúrgica, sem danificar a pintura original do seu veículo. Recupere a aparência de novo e maximize o valor do seu patrimônio."
      cta={{ rotulo: 'Pedir avaliação online grátis', href: whats(msg.avaliacao), whats: true }}
      cta2={{ rotulo: 'Ver o reparo em vídeo', href: '#video' }}
      prova="Garantia em todos os serviços. +1.000 clientes atendidos em SP."
      foto={{
        src: img('martelinho-tecnico-464.webp'),
        alt: 'Técnico da LM trabalhando na tampa traseira de um Nissan Kicks preto, com a barra de luz amarela e o teto de LED hexagonal da oficina',
        largura: 464,
        altura: 580,
        ambiente: 'martelinho-tecnico-ambiente.webp',
        posicao: '40% 50%',
      }}
    />

    <Especificacoes
      id="por-que"
      titulo="Por que escolher o"
      destaque="martelinho de ouro?"
      lead="O amassado sai sem pintura. A originalidade e o valor do seu carro ficam."
      itens={beneficios}
    />

    <!-- QUE AMASSADO SAI: o que resolve e o que não resolve ================ -->
    <section class="resolve" id="resolve" aria-labelledby="resolve-titulo">
      <div class="recipiente">
        <div class="sec-cabeca" data-revelar>
          <h2 id="resolve-titulo">Que amassado sai <span class="destaque-cor">com martelinho?</span></h2>
          <p class="lead">A técnica é ideal quando a pintura não foi danificada, sem trinca nem arranhão.</p>
        </div>
        <div class="resolve__grade">
          {resolve.map((c) => (
            <div class:list={['resolve__coluna', `resolve__coluna--${c.tipo}`, c.tipo === 'sim' ? '' : 'vidro']} data-revelar>
              <h3>{c.titulo}</h3>
              <ul role="list">{c.itens.map((i) => <li>{i}</li>)}</ul>
              {c.nota && <p class="pequeno">{c.nota}</p>}
              {c.link && <a class="link-destaque" href={c.link.href}>{c.link.rotulo}</a>}
            </div>
          ))}
        </div>
        <div class="resolve__acao">
          <a class="btn btn--whats" href={whats(msg.foto)} target="_blank" rel="noopener"><IconeWhats /> Enviar foto do amassado</a>
          <p class="pequeno">Pela foto, você recebe um pré-orçamento online, sem compromisso.</p>
        </div>
      </div>
    </section>

    <Processo id="processo" titulo="Arte e técnica" destaque="em 4 passos" passos={passos}>
      <div class="recipiente processo__fechamento">
        <p class="lead">Pequenos danos podem ser resolvidos em menos de 1 hora. Quase sempre, o serviço é concluído no mesmo dia.</p>
        <a class="btn btn--whats" href={whats(msg.foto)} target="_blank" rel="noopener"><IconeWhats /> Enviar foto do amassado</a>
      </div>
    </Processo>

    <!-- VÍDEO: o reparo inteiro ========================================= -->
    <section class="filme" id="video" aria-labelledby="filme-titulo">
      <div class="recipiente">
        <div class="filme__painel vidro">
        <img class="filme__ambiente" src={img('passo-amassado-ambiente.webp')} alt="" aria-hidden="true" width="96" height="172" loading="lazy" />
        <div class="filme__texto" data-revelar>
          <p class="pilula"><span class="ponto-vivo"></span> Vídeo real</p>
          <h2 id="filme-titulo">Veja um reparo <span class="destaque-cor">do começo ao fim</span></h2>
          <p class="lead">Nissan Kicks, tampa traseira. Do amassado ao reflexo reto, sob a barra de luz da LM.</p>
          <p class="texto">Sem massa, sem lixa, sem solvente, sem tinta. O verniz de fábrica continua lá no final.</p>
        </div>
        <div class="filme__tela" data-revelar>
          <video controls playsinline preload="none" width="464" height="832" poster={img('martelinho-video-poster-464.webp')}>
            <source src="/assets/video/martelinho-completo.mp4" type="video/mp4" />
            <p>Seu navegador não reproduz vídeo. <a href="/assets/video/martelinho-completo.mp4">Baixar o vídeo do reparo</a>.</p>
          </video>
          <p class="pequeno filme__legenda">50 segundos, com som.</p>
        </div>
        </div>
      </div>
    </section>

    <!-- RESULTADOS ========================================================== -->
    <section class="resultados" id="resultados" aria-labelledby="resultados-titulo">
      <div class="recipiente">
        <div class="sec-cabeca" data-revelar>
          <p class="pilula">Antes e depois</p>
          <h2 id="resultados-titulo">Resultados que <span class="destaque-cor">falam por si</span></h2>
        </div>
        <div class="resultados__grade">
          <div class="resultados__comparador vidro" data-revelar>
            <Comparador
              antes={{ src: img('kicks-antes-414.webp'), alt: 'Antes: tampa traseira do Nissan Kicks com amassado; o reflexo da barra de luz aparece entortado' }}
              depois={{ src: img('kicks-depois-414.webp'), alt: 'Depois: a mesma tampa lisa, com o reflexo reto e a pintura original' }}
              largura={414}
              altura={518}
              rotulo="Comparar antes e depois do Nissan Kicks"
            />
            <p class="pequeno">Nissan Kicks, tampa traseira. Arraste a barra de luz.</p>
          </div>

          <div class="resultados__lado">
            <figure class="resultados__figura vidro" data-revelar>
              <img
                src={img('antes-depois-branco-lado-a-lado-720.webp')}
                srcset={`${img('antes-depois-branco-lado-a-lado-720.webp')} 720w, ${img('antes-depois-branco-lado-a-lado-1440.webp')} 1440w`}
                sizes="(min-width: 60rem) 40rem, 100vw"
                width="720"
                height="604"
                alt="Lateral de um carro branco: à esquerda o amassado perto da roda, à direita a mesma lataria lisa depois do martelinho de ouro"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="pequeno">À esquerda, o amassado. À direita, a mesma lataria depois do martelinho de ouro.</figcaption>
            </figure>

            <blockquote class="resultados__citacao" data-revelar>
              <p class="estrelas" aria-label="5 estrelas">★★★★★</p>
              <p class="resultados__frase">"Não dá pra ver onde estava <span class="destaque-cor">o amassado.</span>"</p>
              <footer class="pequeno">Maria O., Jeep Compass</footer>
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <Faq itens={perguntas}>
      <p class="texto">Pintura trincada ou arranhada? Aí o caminho é <a class="link-destaque" href="/servicos#funilaria">funilaria e pintura</a>.</p>
    </Faq>

    <CtaFinal
      pilula="Resposta rápida no horário comercial"
      titulo="Seu carro merece o cuidado de especialistas."
      texto="Envie uma foto do amassado e receba um pré-orçamento online, sem compromisso."
      botao="Enviar foto para orçamento"
      mensagem={msg.foto}
    />
  </main>

  <Rodape />
  <BarraWhats mensagem={msg.pagina} />
</Base>

<style>
  /* =================================================================
     QUE AMASSADO SAI: três caixas, do "sai" ao "não é caso"
     ================================================================= */
  .resolve { padding-top: var(--secao); }
  .resolve__grade { display: grid; gap: 0.9rem; }
  .resolve__coluna { display: grid; gap: 1rem; align-content: start; justify-items: start; padding: 1.5rem; }
  .resolve__coluna--sim {
    border-radius: var(--raio);
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: linear-gradient(145deg, #3a9fe4, #1a5f9c);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 24px 48px -22px rgba(46, 143, 214, 0.8);
  }
  .resolve__coluna h3 { font-size: clamp(1.875rem, 1.6rem + 1vw, 2.5rem); }
  .resolve__coluna ul { display: grid; gap: 0.625rem; }
  .resolve__coluna li { position: relative; padding-left: 1.75rem; font-family: var(--f-apoio); font-size: 1.125rem; }
  .resolve__coluna li::before {
    content: '';
    position: absolute;
    left: 0.125rem;
    top: 0.3em;
    width: 0.8rem;
    height: 0.45rem;
    border-left: 2px solid #fff;
    border-bottom: 2px solid #fff;
    transform: rotate(-45deg);
  }
  /* avaliação: anel vazado */
  .resolve__coluna--talvez li::before {
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--ciano);
    border-radius: 50%;
    transform: none;
  }
  /* não é martelinho: um traço apagado */
  .resolve__coluna--nao li::before {
    top: 0.62em;
    width: 0.8rem;
    height: 0;
    border: 0;
    border-top: 2px solid var(--texto-2);
    transform: none;
  }
  .resolve__coluna--nao li { color: var(--texto-2); }
  .resolve__coluna .pequeno { color: var(--texto-2); }
  .resolve__acao { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 2rem; }

  @media (min-width: 60rem) {
    .resolve__grade { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .resolve__coluna { padding: 2rem; }
  }

  /* =================================================================
     VÍDEO: painel de vidro com a luz da cena ao fundo
     ================================================================= */
  .filme { padding-top: var(--secao); }
  .filme__painel { display: grid; gap: 2rem; align-items: center; overflow: hidden; padding: 1.75rem 1.25rem; --raio: 28px; }
  .filme__ambiente {
    position: absolute;
    inset: -10%;
    z-index: -2;
    width: 120%;
    max-width: none;
    height: 120%;
    object-fit: cover;
    opacity: 0.45; /* o desfoque já vem na imagem */
  }
  .filme__texto { display: grid; gap: 1.1rem; justify-items: start; }
  .filme__texto .texto { color: rgba(242, 245, 248, 0.82); }
  .filme__tela { justify-self: center; width: min(100%, 20rem); }
  .filme__tela video {
    width: 100%;
    border-radius: 20px;
    border: 1px solid rgba(143, 212, 239, 0.35);
    background: var(--noite-2);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8);
  }
  .filme__legenda { margin-top: 0.75rem; text-align: center; }

  @media (min-width: 60rem) {
    .filme__painel { grid-template-columns: minmax(0, 1fr) auto; gap: 4rem; padding: 3.5rem 4rem; }
    .filme__tela { width: min(22rem, calc((100svh - 12rem) * 464 / 832)); }
  }

  /* =================================================================
     RESULTADOS
     ================================================================= */
  .resultados { padding-top: var(--secao); }
  .resultados__grade { display: grid; gap: 1rem; }
  .resultados__comparador { display: grid; gap: 0.75rem; padding: 0.6rem 0.6rem 1rem; width: min(100%, 27rem); }
  .resultados__comparador :global(.comparar__quadro) { border-radius: 16px; }
  .resultados__comparador .pequeno { padding-inline: 0.5rem; }
  .resultados__lado { display: grid; gap: 1rem; align-content: start; }
  .resultados__figura { margin: 0; display: grid; gap: 0.75rem; padding: 0.6rem 0.6rem 1rem; }
  .resultados__figura img { width: 100%; border-radius: 16px; }
  .resultados__figura figcaption { padding-inline: 0.5rem; }
  .resultados__citacao { display: grid; gap: 0.75rem; padding: 1rem 0.5rem; }
  .resultados__frase {
    font-family: var(--f-titulo);
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 4rem);
    line-height: 0.95;
  }

  @media (min-width: 60rem) {
    .resultados__grade { grid-template-columns: auto minmax(0, 1fr); gap: 1.25rem; align-items: start; }
    .resultados__citacao { padding: 1.5rem 1rem; }
  }
</style>
